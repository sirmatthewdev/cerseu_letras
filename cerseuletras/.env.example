APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# En local, sin el contenedor levantado, el host «db» no resuelve. Para
# desarrollar con fichero suelto basta con dejar solo esta línea:
#   DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=cerseu.letras@unmsm.edu.pe
# Gmail NO acepta la contraseña de la cuenta: hace falta una "contraseña de
# aplicación" de 16 caracteres (requiere verificación en dos pasos activada).
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="cerseu.letras@unmsm.edu.pe"
MAIL_FROM_NAME="CERSEU Letras UNMSM"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vista previa de borradores. Lo comparten Laravel y el contenedor de build.
# Vacio desactiva la funcion entera: es preferible que la vista previa no
# funcione a que un descuido deje los borradores a la vista de cualquiera.
CERSEU_VISTA_PREVIA_TOKEN=
