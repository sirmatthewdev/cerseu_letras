APP_NAME=CerseuLetras
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# En Docker la manda el compose como variable del contenedor, que gana sobre
# este fichero: el compose base pone el dominio y la capa de desarrollo
# http://localhost. Este valor solo se usa fuera de Docker.
APP_URL=https://cerseuletras.unmsm.edu.pe

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En un servidor, `warning`. Con `debug` el canal registra tambien cada consulta
# y cada aviso de obsolescencia: el fichero crece sin freno y lo que importa
# queda sepultado entre ruido.
LOG_LEVEL=debug

# Configuración para Docker MySQL. Estos valores son solo un ejemplo para
# desarrollo local: coinciden con los defaults de docker-compose.yml
# (DB_DATABASE, DB_USERNAME, DB_PASSWORD), no con ninguna credencial real.
# En cada entorno hay que poner los propios en el .env local, que nunca se
# commitea.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cerseuletras
DB_USERNAME=cerseu_user
DB_PASSWORD=user_password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="cerseu.letras@unmsm.edu.pe"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Reconstruccion del sitio publico en Astro tras publicar en el panel.
# El token debe coincidir con el del servicio de build (.env de la raiz).
CERSEU_BUILD_URL=http://build:4322/reconstruir
CERSEU_BUILD_TOKEN=token-de-desarrollo

# Contrasenia del administrador inicial. Hay que ponerla ANTES de sembrar: el
# seeder la lee de aqui, y si esta vacia genera una de 20 caracteres y la
# imprime UNA sola vez. No tiene valor por defecto a proposito —un defecto
# conocido abre la cuenta de administrador de cualquier instalacion—, y si el
# usuario ya existe el seeder no se la toca.
#
# Ojo con el orden: despues de `php artisan config:cache` Laravel deja de leer
# este fichero y el seeder ve la variable vacia. Sembrar primero, cachear
# despues.
ADMIN_PASSWORD=

# Vista previa de borradores. Lo comparten Laravel y el contenedor de build.
# Vacio desactiva la funcion entera: es preferible que la vista previa no
# funcione a que un descuido deje los borradores a la vista de cualquiera.
CERSEU_VISTA_PREVIA_TOKEN=
