---
import TituloSeccion from './TituloSeccion.astro';
import type { ConfiguracionSitio } from '../lib/api';
import Boton from './Boton.astro';
import { faArrowRight } from '@fortawesome/free-solid-svg-icons';

interface Props {
    inscripcion: NonNullable<ConfiguracionSitio['inscripcion']>;
}

const { inscripcion } = Astro.props;
---

{/* Degradado y no color plano: es lo que tenia la seccion equivalente en el
    sitio anterior —`from-gray-900 to-[#0C1217]`— y lo que hace que la banda no
    corte la pagina en dos bloques de color. */}
<section
    class="relative isolate overflow-hidden bg-linear-to-b from-[#111827] to-[#0C1217] py-20 text-white"
>
    {/* Textura de puntos: el mismo recurso que usa la banda equivalente en
        Blade, para que las dos versiones se reconozcan. */}
    <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 opacity-[0.06]"
        style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 34px 34px;"
    >
    </div>
    <div
        aria-hidden="true"
        class="absolute -top-40 left-1/2 -z-10 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full bg-unmsm-azul/40 blur-3xl"
    >
    </div>

    <div class="mx-auto max-w-6xl px-6">
        <TituloSeccion
            titulo={inscripcion.titulo ?? 'Cómo inscribirte'}
            kicker={inscripcion.eyebrow ?? undefined}
            centrado
            claro
        />

        {/* La linea que une los pasos nace de cada tarjeta y no de una barra
            suelta por encima: aquella estaba a 24 px del borde, mientras el
            centro de los iconos cae a 48 px —`p-6` mas media altura del
            circulo—, asi que cruzaba a una altura que no correspondia a nada y
            asomaba en los huecos como un trazo perdido. Al colgarla del `li`
            queda alineada por construccion, y solo aparece entre tarjetas. */}
        <ol class="pasos-inscripcion relative mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
                inscripcion.pasos.map((paso, i) => (
                    <li
                        data-revelar
                        class:list={[
                            /* Las cuatro tarjetas comparten tratamiento. El
                               destacado invertia a blanco sobre el fondo
                               oscuro, y en una fila de cuatro eso no se leia
                               como enfasis sino como un fallo de pintado: la
                               distingue el filo degradado y algo mas de
                               fondo, no un color opuesto. */
                            'paso relative rounded-xl p-6 ring-1 transition',
                            paso.destacado
                                ? 'paso-destacado bg-white/[0.12] ring-white/20'
                                : 'bg-white/[0.06] ring-white/10 hover:bg-white/[0.1]',
                        ]}
                    >
                        <div
                            class:list={[
                                'flex h-12 w-12 items-center justify-center rounded-full',
                                paso.destacado
                                    ? 'marca-degradado text-white shadow-lg'
                                    : 'bg-unmsm-dorado/20 text-unmsm-dorado-light ring-1 ring-unmsm-dorado/30',
                            ]}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="h-6 w-6"
                                aria-hidden="true"
                            >
                                <path stroke-linecap="round" stroke-linejoin="round" d={paso.icono_path} />
                            </svg>
                        </div>

                        <p class="mt-4 text-xs font-semibold uppercase tracking-wider opacity-60">
                            Paso {i + 1}
                        </p>
                        <h3 class="mt-1 font-serif text-lg font-bold leading-snug">{paso.titulo}</h3>

                        {paso.fecha && (
                            <p
                                class="mt-2 text-sm font-bold text-unmsm-dorado-light"
                            >
                                {paso.fecha}
                            </p>
                        )}

                        {/* El mismo gris en las cuatro. El destacado llevaba
                            `text-slate-600`, que era lo correcto cuando su
                            tarjeta se invertia a blanco; al pasar a
                            `bg-white/[0.12]` quedo texto oscuro sobre fondo
                            oscuro —1,4:1 de contraste, ilegible— y nadie lo
                            movio. Lo que distingue al destacado es el filo y el
                            fondo, como dice el comentario de arriba, no el
                            color del texto. */}
                        {paso.detalle && (
                            <p class="mt-2 text-sm leading-relaxed text-slate-300">{paso.detalle}</p>
                        )}

                        {paso.publico && (
                            <p class="mt-2 text-xs font-medium opacity-70">· {paso.publico}</p>
                        )}
                    </li>
                ))
            }
        </ol>

        {
            inscripcion.boton && (
                <div class="mt-12 text-center">
                    <Boton href={inscripcion.boton.url} tamano="grande" icono={faArrowRight} iconoAlFinal>
                        {inscripcion.boton.texto}
                    </Boton>
                </div>
            )
        }
    </div>
</section>

<style>
    /*
     * El trazo entre pasos. `top: 3rem` es exactamente el centro del icono:
     * 1.5rem de `p-6` mas 1.5rem de media altura del circulo. Si cambia
     * cualquiera de los dos, cambia aqui — por eso va escrito con esa cuenta a
     * la vista y no con un numero magico.
     */
    @media (min-width: 64rem) {
        .paso::after {
            content: "";
            position: absolute;
            top: 3rem;
            left: 100%;
            width: 1.25rem; /* el `gap-5` de la rejilla */
            height: 1px;
            background: linear-gradient(
                90deg,
                var(--color-unmsm-dorado),
                color-mix(in oklab, var(--color-unmsm-dorado) 30%, transparent)
            );
        }

        /* El ultimo de la fila no conecta con nada. */
        .paso:last-child::after {
            display: none;
        }
    }

    /* El paso destacado se distingue por un filo degradado —el mismo gesto que
       las tarjetas de programa— y no por invertir el color. */
    .paso-destacado::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1.5px;
        background: var(--degradado-marca);
        pointer-events: none;
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
    }
</style>
