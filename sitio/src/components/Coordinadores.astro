---
import TituloSeccion from './TituloSeccion.astro';
import FondoSeccion from './FondoSeccion.astro';
import type { Docente } from '../lib/api';

interface Props {
    /** Docentes con su detalle ya resuelto: hace falta lo que dictan. */
    docentes: Docente[];
}

const { docentes } = Astro.props;

// Quienes coordinan, que es lo que anunciaba la portada anterior. Sin foto
// propia —ninguno la tiene todavía— el círculo se pinta con el degradado de
// marca y las iniciales encima: es exactamente donde el sitio en Blade usaba
// `linear-gradient(135deg, #103050, #B6A350)`, escrito a mano en tres
// plantillas.
const iniciales = (nombre: string) =>
    nombre
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((p) => p[0]?.toUpperCase() ?? '')
        .join('');

const tieneFoto = (url: string) => !url.includes('profesor-default');
---

{
    docentes.length > 0 && (
        <section class="relative isolate overflow-hidden bg-white py-20" aria-labelledby="coordinadores">
            <FondoSeccion deriva={50} />

            <div class="relative mx-auto max-w-6xl px-6">
                <TituloSeccion
                    id="coordinadores"
                    titulo="Coordinadores de programa"
                    kicker="Quiénes enseñan"
                    bajada="Docentes de la UNMSM a cargo de la oferta del CERSEU."
                    centrado
                />

                <ul
                    data-revelar-grupo
                    class="mt-12 grid grid-cols-2 gap-8 md:grid-cols-3 lg:grid-cols-6"
                >
                    {docentes.map((docente) => (
                        <li data-revelar class="text-center">
                            <a href={`/profesores/${docente.slug}`} class="group block">
                                <span class="coordinador-marco mx-auto block h-24 w-24 rounded-full p-[3px] transition duration-500">
                                    {tieneFoto(docente.foto) ? (
                                        <img
                                            src={docente.foto}
                                            alt=""
                                            width="96"
                                            height="96"
                                            loading="lazy"
                                            decoding="async"
                                            /* En gris y a color al pasar, como en el sitio
                                               anterior: la rejilla se lee como un conjunto
                                               y no como seis fotos sueltas. */
                                            class="h-full w-full rounded-full object-cover grayscale transition duration-500 group-hover:grayscale-0"
                                        />
                                    ) : (
                                        <span
                                            aria-hidden="true"
                                            class="flex h-full w-full items-center justify-center rounded-full bg-white font-serif text-xl font-bold text-unmsm-azul"
                                        >
                                            {iniciales(docente.nombre)}
                                        </span>
                                    )}
                                </span>

                                <span class="mt-4 block text-sm font-bold text-slate-800 transition group-hover:text-unmsm-azul">
                                    {docente.nombre}
                                </span>

                                {docente.programas?.[0] && (
                                    <span class="mt-1 block text-xs leading-snug text-slate-500">
                                        {docente.programas.length === 1
                                            ? docente.programas[0].nombre
                                            : `${docente.programas.length} programas`}
                                    </span>
                                )}
                            </a>
                        </li>
                    ))}
                </ul>

                <p class="mt-12 text-center">
                    <a
                        href="/plana-docente"
                        class="text-sm font-semibold text-unmsm-azul hover:underline"
                    >
                        Ver toda la plana docente
                        <span aria-hidden="true"> →</span>
                    </a>
                </p>
            </div>
        </section>
    )
}

<style>
    /* El aro es el degradado de marca; el interior lo tapa el contenido. Es el
       mismo gesto que el filo de las tarjetas, aquí en circular. */
    .coordinador-marco {
        background-image: var(--degradado-marca);
    }

    .group:hover .coordinador-marco {
        transform: scale(1.06);
    }

    @media (prefers-reduced-motion: reduce) {
        .coordinador-marco {
            transition: none;
        }

        .group:hover .coordinador-marco {
            transform: none;
        }
    }
</style>
