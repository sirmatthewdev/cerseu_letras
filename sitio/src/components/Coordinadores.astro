---
import TituloSeccion from './TituloSeccion.astro';
import FondoSeccion from './FondoSeccion.astro';
import EnlacesAcademicos from './EnlacesAcademicos.astro';
import { inicialesDePersona } from '../lib/iniciales';
import type { Docente } from '../lib/api';

interface Props {
    /** Docentes con su detalle ya resuelto: hace falta lo que dictan. */
    docentes: Docente[];
}

const { docentes } = Astro.props;

// Quienes coordinan, que es lo que anunciaba la portada anterior. Sin foto
// propia —ninguno la tiene todavía— el círculo se pinta con el degradado de
// marca y las iniciales encima: es exactamente donde el sitio en Blade usaba
// `linear-gradient(135deg, #103050, #B6A350)`, escrito a mano en tres
// plantillas.
//
// La regla vive en `lib/iniciales`: de aquí salió el monograma que llevan ahora
// también las tarjetas de programa sin fotografía, y tenerla en dos sitios era
// garantizar que acabaran diciendo cosas distintas.

const tieneFoto = (url: string) => !url.includes('profesor-default');
---

{
    docentes.length > 0 && (
        <section class="relative isolate overflow-hidden bg-white py-20" aria-labelledby="coordinadores">
            <FondoSeccion deriva={50} />

            <div class="relative mx-auto max-w-6xl px-6">
                <TituloSeccion
                    id="coordinadores"
                    titulo="Coordinadores de programa"
                    kicker="Quiénes enseñan"
                    bajada="Docentes de la UNMSM a cargo de la oferta del CERSEU."
                    centrado
                />

                {/* Panel en degradado, del gris claro al blanco, con la
                    fotografía enmarcada dentro. Antes era un aro circular sobre
                    fondo blanco: el retrato queda mejor rectangular —es como se
                    hacen las fotos institucionales— y el degradado da a la
                    rejilla un peso que un aro suelto no tiene. */}
                <ul
                    data-revelar-grupo
                    class="mt-12 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-6"
                >
                    {docentes.map((docente) => (
                        <li data-revelar class="h-full">
                            <div class="ficha-coordinador group relative flex h-full flex-col gap-4 rounded-2xl bg-linear-to-b from-slate-100 to-white p-4 transition duration-300">
                                <span class="relative block overflow-hidden rounded-xl bg-white">
                                    {tieneFoto(docente.foto) ? (
                                        <img
                                            src={docente.foto}
                                            alt=""
                                            width="274"
                                            height="274"
                                            loading="lazy"
                                            decoding="async"
                                            /* En gris y a color al pasar, como en el sitio
                                               anterior: la rejilla se lee como un conjunto
                                               y no como seis fotos sueltas. */
                                            class="aspect-square w-full object-cover grayscale transition duration-500 group-hover:grayscale-0 group-hover:scale-105"
                                        />
                                    ) : (
                                        /* Sin foto propia, las iniciales sobre el
                                           degradado de marca. Ocupan el mismo cuadrado,
                                           así que la rejilla no se descuadra el día que
                                           la Unidad suba unas cuantas y otras no. */
                                        <span
                                            aria-hidden="true"
                                            class="marca-degradado flex aspect-square w-full items-center justify-center font-serif text-3xl font-bold text-white"
                                        >
                                            {inicialesDePersona(docente.nombre)}
                                        </span>
                                    )}

                                    {/* Sobre la esquina inferior derecha de la
                                        foto: en una tarjeta de seis columnas no
                                        sobra alto, y debajo del nombre los tres
                                        iconos empujaban la rejilla. `z-10` los
                                        saca por encima del area pulsable, que
                                        cubre la tarjeta entera.

                                        El panel claro de detras no es adorno:
                                        sin el, un icono apagado sobre una foto
                                        —o sobre el degradado de las iniciales—
                                        se pierde, y el hueco deja de leerse
                                        como hueco. */}
                                    <span class="absolute bottom-2 right-2 z-10 rounded-xl bg-white/85 p-1 backdrop-blur-sm">
                                        <EnlacesAcademicos
                                            orcid={docente.orcid}
                                            ctiVitae={docente.cti_vitae}
                                            linkedin={docente.linkedin}
                                            tamano="compacto"
                                            conHuecos
                                        />
                                    </span>
                                </span>

                                {/* Pegado al retrato y no al fondo del panel.
                                    Con `mt-auto` el bloque se alineaba por
                                    abajo, asi que un subtitulo de dos lineas
                                    —el nombre del unico programa que dicta, en
                                    vez de «12 programas»— empujaba el nombre
                                    hacia arriba: los seis nombres de la fila
                                    caian a alturas distintas, hasta 35 px de
                                    diferencia. Colgando del retrato, que mide
                                    siempre lo mismo, quedan alineados por
                                    construccion. */}
                                <span class="block">
                                    <a
                                        href={`/profesores/${docente.slug}`}
                                        class="block text-sm font-bold leading-snug text-slate-800 transition after:absolute after:inset-0 after:rounded-2xl group-hover:text-unmsm-azul"
                                    >
                                        {docente.nombre}
                                    </a>

                                    {docente.programas?.[0] && (
                                        <span class="mt-1 line-clamp-2 text-xs leading-snug text-slate-500">
                                            {docente.programas.length === 1
                                                ? docente.programas[0].nombre
                                                : `${docente.programas.length} programas`}
                                        </span>
                                    )}
                                </span>
                            </div>
                        </li>
                    ))}
                </ul>

                <p class="mt-12 text-center">
                    <a
                        href="/plana-docente"
                        class="text-sm font-semibold text-unmsm-azul hover:underline"
                    >
                        Ver toda la plana docente
                        <span aria-hidden="true"> →</span>
                    </a>
                </p>
            </div>
        </section>
    )
}

<style>
    /* El panel se levanta y estrena filo de marca al pasar: el mismo gesto que
       las tarjetas de programa, para que la portada se lea como un solo
       sistema y no como seis diseños distintos. */
    .ficha-coordinador {
        border: 1px solid transparent;
    }

    .ficha-coordinador:hover,
    .ficha-coordinador:focus-visible {
        transform: translateY(-4px);
        border-color: color-mix(in oklab, var(--color-unmsm-dorado) 55%, transparent);
        box-shadow: 0 16px 32px -20px rgb(15 43 72 / 0.45);
    }

    @media (prefers-reduced-motion: reduce) {
        .ficha-coordinador,
        .ficha-coordinador img {
            transition: none;
        }

        .ficha-coordinador:hover {
            transform: none;
        }
    }
</style>
