---
import TituloSeccion from './TituloSeccion.astro';
import FondoSeccion from './FondoSeccion.astro';
import Boton from './Boton.astro';
import { inicialesDePersona } from '../lib/iniciales';
import Icono from './Icono.astro';
import { faCalendarDay, faFilePdf, faQuoteLeft } from '@fortawesome/free-solid-svg-icons';
import { iconoDeAccion } from '../lib/iconos';
import type { Evento, GrupoInformativos, Testimonio } from '../lib/api';

interface Props {
    eventos: Evento[];
    informativos: GrupoInformativos[];
    testimonios: Testimonio[];
}

const { eventos, informativos, testimonios } = Astro.props;

// Cada sección se oculta si no hay nada que enseñar, igual que en el sitio
// anterior. Una portada con tres bloques vacíos —«Próximamente», «Sin
// documentos»— cuenta peor que una portada sin ellos, y hoy las tres tablas
// están vacías. En cuanto la Unidad publique algo, aparecen solas.
const recursos = informativos.flatMap((grupo) =>
    grupo.recursos.map((recurso) => ({ ...recurso, categoria: grupo.categoria }))
);

const fecha = (valor: string | null) =>
    valor
        ? new Date(valor).toLocaleDateString('es-PE', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
          })
        : null;

/*
 * Retrato del testimonio, o sus iniciales.
 *
 * La API cae a `images/default-avatar.jpg` cuando no hay foto, y ese fichero NO
 * existe en el repositorio: la tarjeta mostraba el icono de imagen rota. Habria
 * salido en cuanto la Unidad cargara el primer testimonio sin retrato, que es lo
 * normal — la gente manda su opinion, no su fotografia.
 *
 * Se resuelve como en la plana docente: iniciales sobre el degradado de marca.
 * Ocupan el mismo circulo, asi que la tarjeta no cambia de forma segun quien
 * tenga foto y quien no.
 */
const tieneRetrato = (url: string | null | undefined) =>
    Boolean(url) && !String(url).includes('default-avatar');

---

{
    testimonios.length > 0 && (
        <section class="relative isolate overflow-hidden bg-slate-50 py-20" aria-labelledby="testimonios">
            <FondoSeccion deriva={50} />
            <div class="mx-auto max-w-7xl px-4 lg:px-8">
                <TituloSeccion
                    id="testimonios"
                    titulo="Lo que dicen quienes ya pasaron"
                    kicker="Testimonios"
                    centrado
                />

                {/* Marco blanco de 4 px sobre el panel gris, como en la
                    referencia: separa la tarjeta del fondo sin dibujar un borde,
                    y con la sección ya en gris el contraste sale solo.

                    Sin puntuación de estrellas: `testimonios` no tiene ese
                    campo, y pintar cinco estrellas fijas seria inventar una
                    valoración que nadie ha dado. */}
                <ul class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {testimonios.slice(0, 6).map((testimonio) => (
                        <li class="tarjeta-testimonio group flex flex-col rounded-xl border-4 border-white bg-slate-100/70 p-6 transition duration-300">
                            <span
                                aria-hidden="true"
                                class="text-unmsm-dorado transition-transform duration-300 group-hover:-rotate-6"
                            >
                                <Icono icono={faQuoteLeft} clase="h-7 w-7" />
                            </span>

                            <blockquote class="mt-4 flex-1 text-lg leading-relaxed text-slate-700">
                                {testimonio.contenido}
                            </blockquote>

                            <div class="mt-auto flex items-center gap-4 pt-6">
                                {tieneRetrato(testimonio.foto) ? (
                                    <img
                                        src={testimonio.foto}
                                        alt=""
                                        width="48"
                                        height="48"
                                        loading="lazy"
                                        decoding="async"
                                        class="h-12 w-12 flex-none rounded-full object-cover ring-2 ring-white"
                                    />
                                ) : (
                                    <span
                                        aria-hidden="true"
                                        class="marca-degradado flex h-12 w-12 flex-none items-center justify-center rounded-full text-sm font-bold text-white ring-2 ring-white"
                                    >
                                        {inicialesDePersona(testimonio.nombre)}
                                    </span>
                                )}
                                <div class="min-w-0 flex-1">
                                    <p class="font-semibold text-unmsm-azul">{testimonio.nombre}</p>
                                    {testimonio.programa && (
                                        <p class="text-sm text-slate-500">{testimonio.programa}</p>
                                    )}
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )
}

{
    eventos.length > 0 && (
        <section class="relative isolate overflow-hidden py-20" aria-labelledby="eventos">
            <FondoSeccion deriva={50} />
            <div class="mx-auto max-w-7xl px-4 lg:px-8">
                <TituloSeccion
                    id="eventos"
                    titulo="Eventos y actividades"
                    kicker="Actualidad"
                    bajada="Conferencias, coloquios y actividades abiertas del CERSEU."
                    centrado
                />

                <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {eventos.slice(0, 3).map((evento) => (
                        <li class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 shadow-sm transition hover:shadow-lg">
                            {evento.imagen && (
                                <img
                                    src={evento.imagen}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                    class="h-44 w-full object-cover"
                                />
                            )}
                            <div class="flex flex-1 flex-col p-6">
                                {fecha(evento.fecha_inicio) && (
                                    <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-unmsm-dorado">
                                        <Icono icono={faCalendarDay} clase="h-3.5 w-3.5" />
                                        {fecha(evento.fecha_inicio)}
                                    </p>
                                )}
                                <h3 class="mt-2 font-serif text-lg font-bold leading-snug text-unmsm-azul">
                                    {evento.titulo}
                                </h3>
                                {evento.descripcion && (
                                    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">
                                        {evento.descripcion}
                                    </p>
                                )}
                                {evento.url && (
                                    <a
                                        href={evento.url}
                                        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-unmsm-azul hover:underline"
                                    >
                                        {/* El enlace de un evento lo escribe la Unidad y
                                            suele salir del sitio —una inscripcion, un
                                            formulario—: ahi el icono avisa de que se sale. */}
                                        <Icono icono={iconoDeAccion(evento.url)} clase="h-4 w-4" />
                                        Ver más
                                    </a>
                                )}
                            </div>
                        </li>
                    ))}
                </ul>

                <div class="mt-10 text-center">
                    <Boton href="/eventos" variante="contorno" icono={iconoDeAccion('/eventos')}>
                        Ver todos los eventos
                    </Boton>
                </div>
            </div>
        </section>
    )
}

{
    recursos.length > 0 && (
        <section class="relative isolate overflow-hidden bg-slate-50 py-20" aria-labelledby="documentos">
            <FondoSeccion deriva={50} />
            <div class="mx-auto max-w-7xl px-4 lg:px-8">
                <TituloSeccion
                    id="documentos"
                    titulo="Documentos y Recursos"
                    kicker="Información institucional"
                    bajada="Reglamentos, formatos y documentos de consulta."
                    centrado
                />

                {/* Deja de ser una lista apilada y pasa a rejilla de
                    tarjetas, como el resto de la portada. En una lista, seis
                    documentos se leen como un indice; en tarjetas, como seis
                    cosas que se pueden abrir — que es lo que son. */}
                <ul data-revelar-grupo class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {recursos.slice(0, 6).map((recurso) => (
                        <li data-revelar>
                            <a
                                href={recurso.url}
                                class="tarjeta-recurso group relative flex h-full flex-col gap-4 rounded-2xl bg-linear-to-b from-slate-100 to-white p-5 transition duration-300"
                            >
                                <span
                                    aria-hidden="true"
                                    class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-unmsm-dorado shadow-sm transition duration-300 group-hover:bg-unmsm-azul group-hover:text-white"
                                >
                                    <Icono icono={faFilePdf} clase="h-5 w-5" />
                                </span>

                                <span class="block">
                                    <span class="block font-semibold leading-snug text-slate-800 transition group-hover:text-unmsm-azul">
                                        {recurso.titulo}
                                    </span>
                                    {recurso.categoria && (
                                        <span class="mt-1 block text-xs uppercase tracking-wide text-slate-500">
                                            {recurso.categoria}
                                        </span>
                                    )}
                                </span>

                                <span
                                    aria-hidden="true"
                                    class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-unmsm-azul"
                                >
                                    {/* El PDF de arriba dice que es un documento; este
                                        dice que se abre fuera de la pagina. No es el mismo
                                        dato, asi que no es el mismo icono. */}
                                    <Icono icono={iconoDeAccion(recurso.url)} clase="h-4 w-4" />
                                    Abrir
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>

                <div class="mt-10 text-center">
                    <Boton href="/informativos" variante="contorno" icono={iconoDeAccion('/informativos')}>
                        Ver todos los documentos
                    </Boton>
                </div>
            </div>
        </section>
    )
}

<style>
    /*
     * El mismo gesto en las tres rejillas de la portada: al pasar, la tarjeta
     * se levanta un poco y estrena un filo dorado. Repetirlo es deliberado —es
     * lo que hace que la portada se lea como un sistema y no como cinco
     * secciones diseñadas por separado.
     */
    .tarjeta-testimonio:hover,
    .tarjeta-recurso:hover,
    .tarjeta-recurso:focus-visible {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px -20px rgb(15 43 72 / 0.45);
    }

    .tarjeta-recurso {
        border: 1px solid transparent;
    }

    .tarjeta-recurso:hover,
    .tarjeta-recurso:focus-visible {
        border-color: color-mix(in oklab, var(--color-unmsm-dorado) 55%, transparent);
    }

    @media (prefers-reduced-motion: reduce) {
        .tarjeta-testimonio,
        .tarjeta-recurso,
        .tarjeta-testimonio *,
        .tarjeta-recurso * {
            transition: none;
        }

        .tarjeta-testimonio:hover,
        .tarjeta-recurso:hover {
            transform: none;
        }
    }
</style>
