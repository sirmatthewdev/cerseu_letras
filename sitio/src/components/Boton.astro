---
import type { IconDefinition } from '@fortawesome/fontawesome-svg-core';
import Icono from './Icono.astro';

interface Props {
    href: string;
    variante?: 'dorado' | 'azul' | 'contorno' | 'contorno-claro';
    tamano?: 'normal' | 'grande';
    /**
     * Va siempre delante del texto, y nombra la accion: a donde lleva el boton
     * o por que canal. Hubo un `iconoAlFinal` para colgar una flecha detras de
     * la frase; se retira con las flechas, que es lo que colgaba de el. Un
     * icono que nombra la accion se lee como la etiqueta de un campo, delante.
     */
    icono?: IconDefinition;
    ancho?: boolean;
    nuevaPestana?: boolean;
    clase?: string;
}

const {
    href,
    variante = 'dorado',
    tamano = 'normal',
    icono,
    ancho = false,
    nuevaPestana = false,
    clase = '',
} = Astro.props;

// Los botones estaban repetidos con sus clases a mano en cada página: seis
// copias del mismo degradado y del mismo `hover`, que se desincronizan en
// cuanto alguien retoca una. Aquí se declaran una vez.
const variantes = {
    dorado: 'bg-unmsm-dorado text-unmsm-azul-dark hover:bg-unmsm-dorado-light shadow-sm hover:shadow-md',
    azul: 'bg-unmsm-azul text-white hover:bg-unmsm-azul-light shadow-sm hover:shadow-md',
    contorno: 'border-2 border-unmsm-azul text-unmsm-azul hover:bg-unmsm-azul hover:text-white',
    'contorno-claro': 'border border-white/40 text-white hover:bg-white/10',
};

const tamanos = {
    normal: 'px-6 py-3 text-sm',
    grande: 'px-8 py-3.5 text-base',
};
---

<a
    href={href}
    target={nuevaPestana ? '_blank' : undefined}
    rel={nuevaPestana ? 'noopener noreferrer' : undefined}
    class:list={[
        'group inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition duration-300',
        variantes[variante],
        tamanos[tamano],
        ancho ? 'w-full' : '',
        clase,
    ]}
>
    {icono && <Icono icono={icono} clase="h-4 w-4" />}
    <slot />
</a>
