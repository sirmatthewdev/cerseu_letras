---
import EnlacesAcademicos from './EnlacesAcademicos.astro';
import Paginacion from './Paginacion.astro';
import type { Docente } from '../lib/api';
import { inicialesDePersona } from '../lib/iniciales';

interface Props {
    /** Los de ESTA pagina. */
    docentes: Docente[];
    /** Cuantos hay en total, para el resumen y el estado vacio. */
    total: number;
    paginaActual: number;
    totalPaginas: number;
}

const { docentes, total, paginaActual, totalPaginas } = Astro.props;

// Ninguno tiene foto propia todavía, así que todos comparten el marcador por
// defecto. Veinte veces la misma silueta se lee como un fallo; unas iniciales
// sobre el azul institucional se leen como una decisión. Cuando la Unidad
// suba fotos reales, la condición se apaga sola.
const tieneFotoPropia = (url: string) => !url.includes('profesor-default');

/* Como en la oferta: `/pagina/N` y no `/N`, para no competir con ninguna ruta
   de ficha. Aqui no habria choque hoy, pero el esquema unico evita tener dos
   convenciones que explicar. */
const urlDe = (pagina: number) =>
    pagina === 1 ? '/plana-docente' : `/plana-docente/pagina/${pagina}`;
---

    <section class="mx-auto max-w-6xl px-6 py-14 pb-24">
        {
            total === 0 ? (
                <p class="py-16 text-center text-slate-500">
                    La plana docente se publicará próximamente.
                </p>
            ) : (
                <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {docentes.map((docente) => (
                        <li data-ficha-docente class="relative flex items-center gap-4 rounded-xl border border-slate-200 p-5 shadow-sm transition hover:border-unmsm-azul/40 hover:shadow-md focus-within:border-unmsm-azul">
                            {/* La tarjeta entera es el area pulsable, pero el
                                enlace es uno solo y esta en el nombre: repetir
                                el enlace en la foto haria que un lector de
                                pantalla anunciara dos veces el mismo destino. */}
                            {tieneFotoPropia(docente.foto) ? (
                                <img
                                    src={docente.foto}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                    class="h-16 w-16 flex-none rounded-full object-cover"
                                />
                            ) : (
                                <span
                                    aria-hidden="true"
                                    class="flex h-16 w-16 flex-none items-center justify-center rounded-full bg-unmsm-azul font-serif text-lg font-bold text-white"
                                >
                                    {inicialesDePersona(docente.nombre)}
                                </span>
                            )}

                            <div class="min-w-0">
                                <p class="font-serif font-bold leading-snug text-unmsm-azul">
                                    <a
                                        href={`/profesores/${docente.slug}`}
                                        class="after:absolute after:inset-0 after:rounded-xl hover:underline focus-visible:outline-none"
                                    >
                                        {docente.nombre}
                                    </a>
                                </p>
                                {docente.grado && (
                                    <p class="mt-0.5 text-sm text-slate-500">{docente.grado}</p>
                                )}

                                {/* `sobreEnlace`: el enlace del nombre cubre la
                                    tarjeta entera, asi que sin sacar estos
                                    iconos por encima, pulsarlos abriria la ficha
                                    en vez del perfil externo. */}
                                <div class="mt-2">
                                    <EnlacesAcademicos
                                        orcid={docente.orcid}
                                        ctiVitae={docente.cti_vitae}
                                        linkedin={docente.linkedin}
                                        tamano="compacto"
                                        sobreEnlace
                                        conHuecos
                                    />
                                </div>
                            </div>
                        </li>
                    ))}
                </ul>
            )
        }

        <Paginacion
            actual={paginaActual}
            total={totalPaginas}
            urlDe={urlDe}
            etiqueta="docentes"
            elementos={total}
        />
    </section>
