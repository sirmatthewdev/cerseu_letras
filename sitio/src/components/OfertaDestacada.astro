---
import TarjetaPrograma from './TarjetaPrograma.astro';
import Icono from './Icono.astro';
import { iconoDeAccion } from '../lib/iconos';
import type { Programa, TipoOferta } from '../lib/api';

interface Props {
    tipos: TipoOferta[];
    programas: Programa[];
    /** Cuántas tarjetas mostrar en cada panel. */
    porPanel?: number;
}

const { tipos, programas, porPanel = 6 } = Astro.props;

// Un botón por tipo más «Todos», en el mismo orden que tenía el sitio anterior:
// los tipos como los da el enum y «Todos» al final.
const filtros = [
    ...tipos.map((t) => ({
        slug: t.slug,
        etiqueta: t.plural,
        cuenta: t.publicados,
        programas: programas.filter((p) => p.tipo === t.slug).slice(0, porPanel),
    })),
    {
        slug: 'todos',
        etiqueta: 'Todos',
        cuenta: programas.length,
        programas: programas.slice(0, porPanel),
    },
];

// Arranca en el primer tipo CON oferta, no en el primero a secas. El sitio
// anterior abría en «Talleres», que hoy no tiene ninguna, así que lo primero
// que veía el visitante era un aviso de que no hay nada.
const inicial = tipos.find((t) => t.publicados > 0)?.slug ?? 'todos';
---

{
    programas.length > 0 && (
        /* El estado del filtro vive en el marcado, con Alpine, y no en un
           script que busca elementos por clase: al renombrar una clase el
           script dejaba de encontrarlos sin que nada avisara. */
        <div x-data={`{ tipo: '${inicial}' }`}>
            <div
                role="tablist"
                aria-label="Filtrar la oferta por tipo"
                class="mb-10 flex flex-wrap justify-center gap-3"
            >
                {/* Un tipo sin oferta se apaga: filo de trazos y texto gris.
                    Se veia igual que «Cursos 39», asi que la unica forma de
                    saber que detras no hay nada era pulsarlo. Ahora lo dice el
                    propio boton, antes del clic.

                    Apagado pero pulsable, no deshabilitado: el panel de un tipo
                    vacio explica el hueco —para eso se escribio— y cerrarle el
                    paso dejaria ese texto sin nadie que lo lea. Se mantiene a la
                    vista, ademas, por lo mismo que la banda de indicadores
                    enseña «Talleres — Proximamente»: el tipo existe y va a
                    volver. */}
                {filtros.map((filtro) => {
                    const vacio = filtro.cuenta === 0;

                    return (
                        <button
                            type="button"
                            role="tab"
                            id={`filtro-${filtro.slug}`}
                            aria-controls={`panel-${filtro.slug}`}
                            x-bind:aria-selected={`tipo === '${filtro.slug}' ? 'true' : 'false'`}
                            x-bind:tabindex={`tipo === '${filtro.slug}' ? 0 : -1`}
                            x-on:click={`tipo = '${filtro.slug}'`}
                            x-bind:class={
                                vacio
                                    ? `tipo === '${filtro.slug}'
                                ? 'marca-degradado border-transparent text-white shadow-md'
                                : 'border-dashed border-slate-300 text-slate-400 hover:border-unmsm-azul hover:text-unmsm-azul'`
                                    : `tipo === '${filtro.slug}'
                                ? 'marca-degradado border-transparent text-white shadow-md'
                                : 'border-slate-300 text-slate-600 hover:border-unmsm-azul hover:text-unmsm-azul'`
                            }
                            class="cursor-pointer rounded-full border px-5 py-2 text-sm font-medium transition duration-300"
                        >
                            {filtro.etiqueta}
                            <span class="ml-1.5 text-xs opacity-70">{filtro.cuenta}</span>
                        </button>
                    );
                })}
            </div>

            {filtros.map((filtro) => (
                <div
                    id={`panel-${filtro.slug}`}
                    role="tabpanel"
                    aria-labelledby={`filtro-${filtro.slug}`}
                    x-show={`tipo === '${filtro.slug}'`}
                    x-transition:enter="transition duration-300 ease-out"
                    x-transition:enter-start="opacity-0 translate-y-2"
                    x-transition:enter-end="opacity-100 translate-y-0"
                    x-cloak
                >
                    {filtro.programas.length > 0 ? (
                        <>
                            <div data-revelar-grupo class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                {filtro.programas.map((programa) => (
                                    <TarjetaPrograma programa={programa} />
                                ))}
                            </div>

                            {filtro.cuenta > porPanel && (
                                <div class="mt-10 text-center">
                                    <a
                                        href={filtro.slug === 'todos' ? '/cursos' : `/${filtro.slug}`}
                                        class="inline-flex items-center gap-2 rounded-lg border-2 border-unmsm-azul px-6 py-3 font-semibold text-unmsm-azul transition duration-300 hover:bg-unmsm-azul hover:text-white"
                                    >
                                        <Icono
                                            icono={iconoDeAccion(
                                                filtro.slug === 'todos' ? '/cursos' : `/${filtro.slug}`
                                            )}
                                            clase="h-4 w-4"
                                        />
                                        Ver {filtro.slug === 'todos' ? 'toda la oferta' : `los ${filtro.cuenta} ${filtro.etiqueta.toLowerCase()}`}
                                    </a>
                                </div>
                            )}
                        </>
                    ) : (
                        /* Un tipo sin oferta se explica, en vez de dejar el
                           panel en blanco. El botón sigue estando: que el
                           CERSEU ofrezca tres tipos es parte de lo que la
                           portada cuenta, aunque dos estén por empezar. */
                        <p class="rounded-2xl border border-dashed border-slate-300 px-6 py-16 text-center text-slate-500">
                            Todavía no hay {filtro.etiqueta.toLowerCase()} publicados. Muy pronto
                            anunciaremos esta parte de la oferta.
                        </p>
                    )}
                </div>
            ))}

            {/* Sin JavaScript, Alpine no evalúa nada: `x-cloak` no se retira y
                los paneles se quedarían todos ocultos, con la sección vacía.
                Aquí se devuelve la visibilidad al panel inicial —por id, que
                gana en especificidad al `[x-cloak]`— y se retiran las pestañas,
                que sin JavaScript no cambiarían nada. */}
            <noscript>
                <style
                    set:html={`#panel-${inicial} { display: block }
                               [role="tablist"] { display: none }`}
                />
            </noscript>
        </div>
    )
}

<style is:global>
    /* Evita el parpadeo: los paneles no se ven hasta que Alpine decide cuál
       toca. Sin esto se pintan todos durante un fotograma.
       Sin `!important` a propósito: el bloque de <noscript> lo anula por
       especificidad para devolver el panel inicial, y con `!important` no
       podría. */
    [x-cloak] {
        display: none;
    }
</style>
