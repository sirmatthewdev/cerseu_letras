---
import { Image } from 'astro:assets';
import { paraDescargar, type Programa } from '../lib/api';
import { iconoDeAccion } from '../lib/iconos';
import { anguloDelFondo, inicialesDePrograma } from '../lib/iniciales';
import Icono from './Icono.astro';

interface Props {
    programa: Programa;
}

const { programa } = Astro.props;

// La ruta se compone aquí, no viene de la API: el backend entrega identidad
// (tipo + slug) y cada frontend decide su estructura de enlaces.
const ruta = `/${programa.tipo}/${programa.slug}`;

/*
 * La fila de datos, con separadores.
 *
 * Antes estos distintivos iban flotando sobre la fotografía, y eso obligaba a
 * pintar un velo oscuro debajo para que se leyeran. Bajarlos aquí quita el velo,
 * deja ver la imagen entera y además los ordena: tipo, modalidad y las medidas
 * que le son propias a cada tipo —horas académicas, sesiones, módulos—, que las
 * calcula el modelo y no esta plantilla.
 */
const datos = [programa.tipo_label, programa.modalidad, ...programa.medidas].filter(Boolean);

/*
 * `imagen_propia` y no `imagen`, que nunca llega vacia.
 *
 * El modelo sustituye la imagen que falta por una foto del campus segun el
 * tipo. Para la ficha esta bien —una foto del campus presidiendo una pagina es
 * una foto del campus—, pero aqui son 39 tarjetas seguidas con exactamente la
 * misma fotografia: la rejilla se lee como un fallo de pintado. La API dice
 * ahora cual de las dos es, y esta tarjeta elige.
 */
const conFotografia = programa.imagen_propia && programa.imagen;

/*
 * El alto del marco, el de la plantilla de referencia: 250 px.
 *
 * En una constante porque lo comparten la fotografía y el monograma. Si los dos
 * no miden exactamente lo mismo, la rejilla da un salto el día que la Unidad
 * suba una foto a un programa y no a los de al lado.
 */
const ALTO_MARCO = 'h-[15.625rem]';
---

<article
    data-revelar
    class="tarjeta-programa group relative flex flex-col rounded-2xl bg-slate-50 p-6 transition duration-300 hover:-translate-y-1"
>
    {/* Marco de la imagen. El «paspartú» blanco de 4 px es lo que separa la
        foto del panel gris sin necesidad de un borde: es el gesto de la
        referencia, y aquí funciona igual porque el panel también es claro. */}
    <div class="marco-foto relative overflow-hidden rounded-xl">
        <div class="overflow-hidden rounded-2xl border-4 border-white bg-slate-100">
            {
                conFotografia ? (
                    <Image
                        src={paraDescargar(programa.imagen!)}
                        alt=""
                        width={640}
                        height={400}
                        loading="lazy"
                        decoding="async"
                        class={`${ALTO_MARCO} w-full object-cover transition duration-500 group-hover:scale-105`}
                    />
                ) : (
                    /* Sin fotografia, el monograma: el mismo recurso que usan
                       las tarjetas de coordinador sin retrato. Ocupa el mismo
                       alto que la foto, asi que la tarjeta no cambia de tamaño
                       el dia que la Unidad suba unas cuantas y otras no.

                       El degradado es el de la banda ancha y no el de marca
                       —que es el de los coordinadores— porque aqui hay texto
                       encima y en un rectangulo de 208 px el dorado de marca
                       ocupa medio fondo: sobre el, las letras blancas se
                       quedan sin contraste. Este lleva el dorado rebajado y
                       solo en el ultimo tramo. Es la misma razon por la que
                       existe, escrita en `global.css`.

                       La inclinacion sale del slug. Con 39 programas las
                       iniciales se repiten, y dos monogramas iguales sobre el
                       mismo fondo son dos tarjetas iguales. */
                    <div
                        aria-hidden="true"
                        class={`marca-degradado-banda flex ${ALTO_MARCO} w-full items-center justify-center`}
                        style={`--angulo-banda: ${anguloDelFondo(programa.slug)}deg`}
                    >
                        <span class="monograma font-serif text-5xl font-bold tracking-wide text-white/90">
                            {inicialesDePrograma(programa.nombre)}
                        </span>
                    </div>
                )
            }
        </div>

        {/* Velo y flecha, solo donde hay ratón. En una pantalla táctil el
            «hover» se dispara con el primer toque y el adorno aparece justo
            cuando ya se está navegando: no aporta nada y tapa la foto.

            Van también sobre el monograma, y no solo sobre la fotografía: hoy
            ningún programa tiene imagen propia, de modo que reservarlos para la
            foto era dejar la rejilla entera sin el gesto. Lo que estorbaba era
            el círculo cayendo encima de las letras —«DE I» se leía «D→I»—, y
            eso se resuelve atenuando el monograma al pasar: las letras se
            retiran y el círculo queda limpio. */}
        <span aria-hidden="true" class="velo-foto" />

        <span aria-hidden="true" class="flecha-foto">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
            </svg>
        </span>

        {
            programa.estado === 'proximamente' && (
                /* Lo único que sigue sobre la foto: no es una categoría sino un
                   aviso de que todavía no se puede cursar, y ahí se ve antes. */
                <span class="absolute right-3 top-3 rounded-full bg-unmsm-dorado px-3 py-1 text-xs font-semibold text-unmsm-azul-dark shadow-sm">
                    Próximamente
                </span>
            )
        }
    </div>

    <div class="mt-4 flex flex-1 flex-col gap-4">
        {
            datos.length > 0 && (
                <p class="flex flex-wrap items-center gap-x-2.5 gap-y-px text-sm font-medium text-slate-500">
                    {datos.map((dato, i) => (
                        <>
                            {i > 0 && (
                                <span
                                    aria-hidden="true"
                                    class="inline-block h-[3px] w-[3px] rounded-full bg-slate-400"
                                />
                            )}
                            <span>{dato}</span>
                        </>
                    ))}
                </p>
            )
        }

        <h3 class="font-serif text-lg font-bold leading-snug text-unmsm-azul">
            {/* El enlace cubre la tarjeta entera, pero el texto accesible sigue
                siendo solo el título: un área de clic grande no tiene por qué
                convertirse en un nombre de enlace largo.

                Y es UN solo enlace. La referencia pone dos —uno sobre la imagen
                y otro en el botón— que llevan al mismo sitio, y un lector de
                pantalla los anuncia los dos: la misma ficha, dos veces. */}
            <a href={ruta} class="after:absolute after:inset-0 after:rounded-2xl hover:underline">
                {programa.nombre}
            </a>
        </h3>

        {programa.sumilla && (
            <p class="line-clamp-3 text-sm leading-relaxed text-slate-600">
                {programa.sumilla}
            </p>
        )}

        {/* Botón de mentira: `aria-hidden` porque el enlace de verdad es el
            título. Está por lo que dice —que hay más ficha detrás—, no por
            dónde lleva.

            `mt-auto` en el envoltorio para que caiga al fondo del panel. Las
            tarjetas ya miden todas lo mismo —la rejilla las estira—, pero el
            botón colgaba del final del texto, así que en una fila con títulos
            de dos y de tres líneas quedaba a tres alturas distintas. El hueco
            mínimo lo da el `pt-5` del envoltorio y no un margen del botón, que
            `mt-auto` se comería. */}
        <span class="mt-auto block">
            <span
                aria-hidden="true"
                class="boton-tarjeta inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition duration-300"
            >
                {/* Delante del texto y sin desplazarse al pasar, como el resto
                    de botones del sitio: el icono nombra lo que hay al otro
                    lado —la ficha del programa— y no la direccion en que se
                    va. */}
                <Icono icono={iconoDeAccion(ruta)} clase="h-4 w-4" />
                Más información
            </span>
        </span>
    </div>
</article>

<style>
    /*
     * Filo de marca al pasar: azul a dorado, el gesto que identificaba al sitio
     * anterior —que lo tenía escrito a mano en tres plantillas—. La máscara
     * recorta el interior, así que queda solo el borde y el panel conserva su
     * fondo sin envolverlo en otro elemento.
     */
    .tarjeta-programa::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: inherit;
        padding: 1.5px;
        background: var(--degradado-marca);
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
    }

    .tarjeta-programa:hover::after,
    .tarjeta-programa:focus-within::after {
        opacity: 1;
    }

    .tarjeta-programa:hover,
    .tarjeta-programa:focus-within {
        box-shadow: 0 18px 40px -22px rgb(15 43 72 / 0.45);
    }

    /* Velo que sube desde abajo, del color del propio panel: así el pie de la
       foto se funde con la tarjeta en vez de oscurecerse. Se apaga al 20 % y no
       a media altura, como en la plantilla: es el pie lo que se funde, y
       subiendo más lo que hacía era deslavar la imagen entera. */
    .velo-foto {
        position: absolute;
        inset: 0;
        z-index: 10;
        display: none;
        pointer-events: none;
        border-radius: inherit;
        background: linear-gradient(to top, var(--color-slate-50, #f8fafc), transparent 20%);
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    /*
     * El círculo de la plantilla: 4 rem, blanco, y entra solo con la opacidad.
     * Llevaba además un `scale`, y dos cosas moviéndose a la vez —la imagen
     * acercándose y el círculo creciendo— se leen como dos animaciones
     * compitiendo. Con una sola, la que se mueve es la imagen y el círculo
     * simplemente aparece encima.
     */
    .flecha-foto {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 20;
        display: none;
        height: 4rem;
        width: 4rem;
        align-items: center;
        justify-content: center;
        border-radius: 9999px;
        background: #fff;
        color: var(--color-unmsm-azul-dark);
        box-shadow: 0 10px 24px -12px rgb(15 43 72 / 0.5);
        opacity: 0;
        transform: translate(-50%, -50%);
        transition: opacity 0.5s ease;
        pointer-events: none;
    }

    /* El monograma se retira para dejar sitio al círculo. */
    .monograma {
        transition: opacity 0.5s ease;
    }

    /*
     * Solo donde hay raton de verdad.
     *
     * `(hover: hover) and (pointer: fine)` y no un `md:`: lo que decide si este
     * adorno tiene sentido no es el ancho de la pantalla sino el dispositivo. En
     * una tableta ancha con dedo, el «hover» se dispara con el primer toque y la
     * flecha aparece justo cuando ya se esta navegando — tapando la foto.
     */
    @media (hover: hover) and (pointer: fine) {
        .velo-foto,
        .flecha-foto {
            display: flex;
        }

        .group:hover .velo-foto {
            opacity: 1;
        }

        .group:hover .flecha-foto {
            opacity: 1;
        }

        .group:hover .monograma {
            opacity: 0.3;
        }
    }

    .boton-tarjeta {
        border-color: color-mix(in oklab, var(--color-unmsm-azul) 25%, transparent);
        color: var(--color-unmsm-azul);
    }

    .group:hover .boton-tarjeta,
    .group:focus-within .boton-tarjeta {
        background-color: var(--color-unmsm-azul);
        border-color: var(--color-unmsm-azul);
        color: #fff;
    }

    @media (prefers-reduced-motion: reduce) {
        .tarjeta-programa,
        .tarjeta-programa::after,
        .velo-foto,
        .flecha-foto,
        .boton-tarjeta,
        .tarjeta-programa img {
            transition: none;
        }

        .tarjeta-programa:hover {
            transform: none;
        }
    }
</style>
