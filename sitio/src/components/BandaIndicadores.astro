---
import type { TipoOferta } from '../lib/api';
import Icono from './Icono.astro';
import { faGraduationCap, faUsers, faLandmark } from '@fortawesome/free-solid-svg-icons';

interface Props {
    tipos: TipoOferta[];
    docentes: number;
}

const { tipos, docentes } = Astro.props;

// La UNMSM se fundó el 12 de mayo de 1551. Se calcula, no se escribe: un
// número fijo aquí envejece solo cada 12 de mayo.
const hoy = new Date();
const anios = hoy.getFullYear() - 1551 - (hoy < new Date(hoy.getFullYear(), 4, 12) ? 1 : 0);

const cifras = [
    ...tipos.map((t) => ({
        valor: t.publicados > 0 ? String(t.publicados) : '—',
        etiqueta: t.plural,
        nota: t.publicados === 0 ? 'Próximamente' : null,
        icono: faGraduationCap,
        enlace: `/${t.slug}`,
    })),
    { valor: `${docentes}`, etiqueta: 'Docentes', nota: null, icono: faUsers, enlace: '/plana-docente' },
    { valor: String(anios), etiqueta: 'Años de historia', nota: null, icono: faLandmark, enlace: null },
];

/*
 * En dos columnas, un número impar de cifras deja la última sola y pegada a la
 * izquierda. Son cinco —los tres tipos, los docentes y los años—, así que en
 * móvil pasaba siempre. La última ocupa entonces el ancho completo y queda
 * centrada como las demás; se calcula y no se escribe «5» porque el día que la
 * Unidad añada un cuarto tipo serían seis y no sobraría ninguna.
 */
const ultimaSola = cifras.length % 2 === 1;
---

{/* Banda oscura pegada al hero, como en Blade: se lee como el pie de la
    portada y no como una sección aparte. */}
<section
    class="relative isolate bg-linear-to-b from-[#0F1B26] to-[#0C1217] text-white"
    aria-label="El CERSEU en cifras"
>
    <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 opacity-[0.05]"
        style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 30px 30px;"
    >
    </div>

    {/* La regla de marca cierra la banda por arriba, como el filo dorado que
        separaba el pie en el sitio anterior. */}
    <div class="marca-regla h-px w-full opacity-70" aria-hidden="true"></div>

    <dl
        data-revelar-grupo
        class="mx-auto grid max-w-6xl grid-cols-2 gap-y-6 px-6 py-10 sm:grid-cols-3 lg:grid-cols-5 lg:divide-x lg:divide-white/10"
    >
        {
            cifras.map((cifra, i) => {
                const Etiqueta = cifra.enlace ? 'a' : 'div';
                return (
                    <Etiqueta
                        href={cifra.enlace ?? undefined}
                        class:list={[
                            'group block px-4 text-center',
                            cifra.enlace ? 'transition hover:text-unmsm-dorado-light' : '',
                            ultimaSola && i === cifras.length - 1 ? 'max-sm:col-span-2' : '',
                        ]}
                    >
                        {/* Iconos de FontAwesome resueltos en el build, los
                            mismos que usa el sitio anterior: los de contorno
                            fino que habia aqui se leian como hexagonos sueltos
                            al tamano al que se pintan. */}
                        <span
                            data-revelar
                            class="mx-auto flex h-7 items-center justify-center text-unmsm-dorado"
                        >
                            <Icono icono={cifra.icono} clase="h-6 w-6" />
                        </span>
                        <dd
                            class="mt-2 font-serif text-3xl font-bold"
                            data-contador={cifra.valor}
                        >
                            {cifra.valor}
                        </dd>
                        <dt class="mt-1 text-[0.7rem] font-medium uppercase tracking-wider text-slate-300">
                            {cifra.etiqueta}
                        </dt>
                        {cifra.nota && (
                            <p class="mt-0.5 text-[0.65rem] uppercase tracking-wider text-unmsm-dorado/70">
                                {cifra.nota}
                            </p>
                        )}
                    </Etiqueta>
                );
            })
        }
    </dl>
</section>
