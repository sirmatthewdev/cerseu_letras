---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import EstadoVacio from '../components/EstadoVacio.astro';
import { obtenerPaginaOpcional, obtenerConfiguracion } from '../lib/api';

const pagina = await obtenerPaginaOpcional('tramites');
const { contacto } = await obtenerConfiguracion();

// Tantas secciones como cargue la Unidad desde el panel, sin número fijo: hoy
// son tres (constancia, certificado, duplicado) y mañana pueden ser cinco.
const secciones = pagina.secciones;
const conCuerpo = secciones.filter((s) => s.cuerpo.trim() !== '');

// El buzón de trámites si la Unidad lo declaró aparte; si no, el general.
const correoTramites = contacto.email_tramites ?? contacto.email;
---

<Base
    titulo={pagina.titulo ?? 'Trámites'}
    descripcion="Constancias, certificados y duplicados del CERSEU de la Facultad de Letras UNMSM."
>
    <HeroPagina
        titulo={pagina.titulo ?? "Trámites"}
        bajada={pagina.subtitulo}
        kicker="Constancias y certificados"
        migas={[{ texto: "Inicio", url: "/" }, { texto: pagina.titulo ?? "Trámites" }]}
    />

    <div class="mx-auto max-w-4xl px-6 py-14 pb-24">
        {
            secciones.length === 0 ? (
                /* El mismo `EstadoVacio` que el resto del sitio, y con
                   salida: un trámite es algo que alguien necesita hoy, así que
                   mientras no esté publicado lo menos que se puede hacer es dar
                   la dirección a la que escribir. */
                <EstadoVacio
                    titulo="Próximamente"
                    texto="La información de trámites se publicará en breve."
                    accion={
                        correoTramites
                            ? { texto: 'Escribir al CERSEU', url: `mailto:${correoTramites}` }
                            : undefined
                    }
                />
            ) : (
                <>
                    {/* Índice: con tres o más trámites, bajar buscando el propio
                        es peor que elegirlo de una lista. */}
                    {secciones.length > 1 && (
                        <nav aria-label="Trámites disponibles" class="mb-10">
                            <ul class="flex flex-wrap gap-3">
                                {secciones.map((s, i) => (
                                    <li>
                                        <a
                                            href={`#tramite-${i}`}
                                            class="inline-block rounded-full border border-unmsm-azul/30 px-4 py-1.5 text-sm font-medium text-unmsm-azul transition hover:bg-unmsm-azul hover:text-white"
                                        >
                                            {s.titulo}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    )}

                    <div class="space-y-8">
                        {secciones.map((seccion, i) => (
                            <section
                                id={`tramite-${i}`}
                                class="scroll-mt-24 rounded-xl border border-slate-200 p-6 shadow-sm"
                            >
                                <h2 class="font-serif text-xl font-bold text-unmsm-azul">
                                    {seccion.numeral && (
                                        <span class="mr-2 text-unmsm-dorado">{seccion.numeral}</span>
                                    )}
                                    {seccion.titulo}
                                </h2>

                                {seccion.cuerpo.trim() !== '' ? (
                                    <div
                                        class="prose prose-slate mt-4 max-w-none prose-a:text-unmsm-azul"
                                        set:html={seccion.cuerpo}
                                    />
                                ) : (
                                    /* Sin contenido cargado todavía. Se dice, en vez de
                                       dejar un titular suelto que parece un fallo. */
                                    <p class="mt-4 text-sm text-slate-500">
                                        Los requisitos de este trámite se publicarán próximamente.
                                        {contacto.email_tramites && (
                                            <>
                                                {' '}Mientras tanto, escribe a{' '}
                                                <a
                                                    href={`mailto:${contacto.email_tramites}`}
                                                    class="text-unmsm-azul underline"
                                                >
                                                    {contacto.email_tramites}
                                                </a>
                                                .
                                            </>
                                        )}
                                    </p>
                                )}
                            </section>
                        ))}
                    </div>

                    {conCuerpo.length === 0 && (
                        <p class="mt-10 text-center text-sm text-slate-400">
                            {secciones.length} trámites anunciados, ninguno con requisitos
                            publicados aún.
                        </p>
                    )}
                </>
            )
        }
    </div>
</Base>
