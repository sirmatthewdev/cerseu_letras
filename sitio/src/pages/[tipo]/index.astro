---
import Base from '../../layouts/Base.astro';
import ListadoDeOferta from '../../components/ListadoDeOferta.astro';
import { obtenerTipos, obtenerProgramas, POR_PAGINA } from '../../lib/api';

// Una sola plantilla para talleres, cursos y especializaciones: las rutas salen
// de la API, que a su vez las saca del enum TipoOferta. Añadir un cuarto tipo en
// Laravel lo publica aquí sin tocar este fichero — la misma propiedad que tenía
// el sitio en Blade, conservada al cruzar de stack.
//
// Esta ruta es la primera página. Las siguientes viven en `pagina/[pagina]`, y
// las dos pintan el mismo componente: el hero, el formulario y la rejilla son
// idénticos, y tenerlos en dos ficheros era garantizar que acabaran divergiendo.
export async function getStaticPaths() {
    const tipos = await obtenerTipos();

    return Promise.all(
        tipos.map(async (tipo) => {
            const todos = await obtenerProgramas(tipo.slug);

            return {
                params: { tipo: tipo.slug },
                props: {
                    tipo,
                    todos,
                    programas: todos.slice(0, POR_PAGINA),
                    totalPaginas: Math.max(1, Math.ceil(todos.length / POR_PAGINA)),
                },
            };
        })
    );
}

const { tipo, todos, programas, totalPaginas } = Astro.props;
---

<Base
    titulo={tipo.hero.titulo}
    descripcion={tipo.hero.texto ?? `Oferta de ${tipo.plural.toLowerCase()} del CERSEU.`}
    imagen={tipo.hero.imagen}
>
    <ListadoDeOferta
        tipo={tipo}
        programas={programas}
        todos={todos}
        paginaActual={1}
        totalPaginas={totalPaginas}
    />
</Base>
