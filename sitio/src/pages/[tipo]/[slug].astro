---
import Base from '../../layouts/Base.astro';
import InversionPrograma from '../../components/InversionPrograma.astro';
import TarjetaPrograma from '../../components/TarjetaPrograma.astro';
import Boton from '../../components/Boton.astro';
import ListaContenido from '../../components/ListaContenido.astro';
import { faUserPlus } from '@fortawesome/free-solid-svg-icons';
import { faWhatsapp } from '@fortawesome/free-brands-svg-icons';
import {
    obtenerTipos,
    obtenerProgramas,
    obtenerPrograma,
    obtenerConfiguracion,
} from '../../lib/api';

// Una página por programa, generada en el build. Con 39 cursos son 39 ficheros
// HTML que el visitante recibe sin que se ejecute nada del lado del servidor.
export async function getStaticPaths() {
    const tipos = await obtenerTipos();
    const rutas = [];

    for (const tipo of tipos) {
        const programas = await obtenerProgramas(tipo.slug);

        for (const programa of programas) {
            // Se pide la ficha completa: el listado no trae docentes, para no
            // pagar esa consulta 39 veces cuando solo hacen falta aquí.
            rutas.push({
                params: { tipo: tipo.slug, slug: programa.slug },
                props: {
                    tipo,
                    programa: await obtenerPrograma(programa.slug),
                    // Otros del mismo tipo, para no dejar la ficha sin salida.
                    relacionados: programas.filter((p) => p.slug !== programa.slug).slice(0, 3),
                },
            });
        }
    }

    return rutas;
}

const { tipo, programa, relacionados } = Astro.props;
const { contacto } = await obtenerConfiguracion();

const docentes = programa.docentes ?? [];
const coordinador = docentes.find((d) => d.es_coordinador) ?? docentes[0];

// Solo las filas con dato. Blade pinta la ficha entera aunque los campos estén
// vacíos —«Duración» sin nada debajo, «Inversión total: Por definir»— y quien
// la lee no sabe si falta el dato o es que no aplica.
const datosClave = [
    { etiqueta: 'Tipo', valor: programa.tipo_label },
    ...programa.medidas.map((m) => ({ etiqueta: 'Duración', valor: m })),
    { etiqueta: 'Modalidad', valor: programa.modalidad },
    { etiqueta: 'Mención', valor: programa.mencion },
    { etiqueta: programa.grado_otorga_label ?? 'Otorga', valor: programa.grado_otorga },
    { etiqueta: 'Vacantes', valor: programa.vacantes ? String(programa.vacantes) : null },
].filter((d): d is { etiqueta: string; valor: string } => Boolean(d.valor));

// La inversión ya no cabe en una fila: son hasta cinco bloques con el orden
// que fijó la Unidad. Va en su propia sección.
const inversion = programa.inversion;

const datosCurso = {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: programa.nombre,
    description: programa.sumilla ?? undefined,
    inLanguage: 'es',
    provider: {
        '@type': 'EducationalOrganization',
        name: 'CERSEU · Facultad de Letras UNMSM',
    },
    ...(programa.modalidad
        ? { hasCourseInstance: { '@type': 'CourseInstance', courseMode: programa.modalidad } }
        : {}),
};

const iniciales = (nombre: string) =>
    nombre
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((p) => p[0]?.toUpperCase() ?? '')
        .join('');
---

<Base
    titulo={programa.nombre}
    descripcion={programa.sumilla ?? undefined}
    imagen={programa.imagen ?? undefined}
    datos={datosCurso}
>
    <article>
        <header class="relative isolate overflow-hidden text-white">
            {
                programa.imagen && (
                    <img
                        src={programa.imagen}
                        alt=""
                        fetchpriority="high"
                        decoding="async"
                        class="absolute inset-0 -z-10 h-full w-full object-cover"
                    />
                )
            }
            <div
                aria-hidden="true"
                class="absolute inset-0 -z-10 bg-linear-to-r from-unmsm-azul-dark/95 via-unmsm-azul/90 to-unmsm-azul/70"
            >
            </div>

            <div class="mx-auto max-w-6xl px-6 py-16">
                <nav class="text-sm text-unmsm-azul-soft" aria-label="Ruta de navegación">
                    <a href="/" class="hover:text-white">Inicio</a>
                    <span aria-hidden="true"> / </span>
                    <a href={`/${tipo.slug}`} class="hover:text-white">{tipo.plural}</a>
                </nav>

                <p class="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-unmsm-dorado-light">
                    {programa.tipo_label}
                    {programa.mencion && ` · ${programa.mencion}`}
                </p>

                <h1 class="mt-3 max-w-4xl font-serif text-3xl font-bold leading-tight sm:text-4xl">
                    {programa.nombre}
                </h1>

                <ul class="mt-6 flex flex-wrap gap-3 text-sm">
                    {
                        programa.medidas.map((medida) => (
                            <li class="rounded-full bg-unmsm-dorado/90 px-4 py-1.5 font-semibold text-unmsm-azul-dark">
                                {medida}
                            </li>
                        ))
                    }
                    {
                        programa.modalidad && (
                            <li class="rounded-full bg-white/10 px-4 py-1.5 ring-1 ring-white/20">
                                {programa.modalidad}
                            </li>
                        )
                    }
                </ul>
            </div>
        </header>

        <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 pb-24 lg:grid-cols-3">
            <div class="space-y-10 lg:col-span-2">
                {
                    coordinador && (
                        <section class="flex items-center gap-4 rounded-xl border border-slate-200 bg-slate-50 p-5">
                            <span
                                aria-hidden="true"
                                class="flex h-12 w-12 flex-none items-center justify-center rounded-full bg-unmsm-azul font-serif font-bold text-white"
                            >
                                {iniciales(coordinador.nombre)}
                            </span>
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                                    {coordinador.denominacion
                                        ? `${coordinador.denominacion} del ${programa.tipo_label ?? 'programa'}`
                                        : (coordinador.rol ?? 'A cargo de')}
                                </p>
                                <p class="font-serif font-bold text-unmsm-azul">
                                    {coordinador.grado && `${coordinador.grado} `}
                                    {coordinador.nombre}
                                </p>
                            </div>
                        </section>
                    )
                }

                {
                    programa.sumilla && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">
                                Sobre el programa
                            </h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />
                            <p class="mt-5 leading-relaxed text-slate-700">{programa.sumilla}</p>
                        </section>
                    )
                }

                {/* Los bloques largos que edita el panel. Cada uno aparece solo
                    si tiene contenido: hoy los 39 programas los tienen vacios y
                    pintar los titulos igual —como hacia el sitio anterior— deja
                    una ficha con seis encabezados y nada debajo. */}
                {
                    programa.por_que && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">
                                ¿Por qué estudiar este programa?
                            </h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />
                            <div
                                class="prose prose-slate mt-5 max-w-none"
                                set:html={programa.por_que}
                            />
                        </section>
                    )
                }

                {
                    programa.objetivos && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">
                                Objetivos académicos
                            </h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />
                            <ListaContenido valor={programa.objetivos} />
                        </section>
                    )
                }

                {
                    programa.plan_estudios && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">
                                Plan de estudios
                            </h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />
                            <ListaContenido valor={programa.plan_estudios} />
                        </section>
                    )
                }

                {
                    (programa.perfil_ingresante || programa.perfil_graduado) && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">Perfiles</h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />

                            <div class="mt-5 grid gap-6 sm:grid-cols-2">
                                {programa.perfil_ingresante && (
                                    <div class="rounded-xl border border-slate-200 p-5">
                                        <h3 class="font-semibold text-slate-800">Del ingresante</h3>
                                        <ListaContenido
                                            valor={programa.perfil_ingresante}
                                            clase="prose prose-slate prose-sm mt-2 max-w-none"
                                        />
                                    </div>
                                )}
                                {programa.perfil_graduado && (
                                    <div class="rounded-xl border border-slate-200 p-5">
                                        <h3 class="font-semibold text-slate-800">Al egresar</h3>
                                        <ListaContenido
                                            valor={programa.perfil_graduado}
                                            clase="prose prose-slate prose-sm mt-2 max-w-none"
                                        />
                                    </div>
                                )}
                            </div>
                        </section>
                    )
                }

                {
                    inversion && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">
                                Inversión económica
                            </h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />
                            <div class="mt-6">
                                <InversionPrograma inversion={inversion} />
                            </div>
                        </section>
                    )
                }

                {
                    programa.documentos.length > 0 && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">Documentos</h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />
                            <ul class="mt-5 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200">
                                {programa.documentos.map((documento) => (
                                    <li>
                                        <a
                                            href={documento.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex items-center justify-between px-5 py-4 transition hover:bg-slate-50"
                                        >
                                            <span class="font-medium text-slate-800">{documento.titulo}</span>
                                            <span aria-hidden="true" class="text-slate-400">↗</span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }

                {
                    docentes.length > 1 && (
                        <section>
                            <h2 class="font-serif text-2xl font-bold text-unmsm-azul">Plana docente</h2>
                            <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />
                            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                                {docentes.map((docente) => (
                                    <li class="rounded-lg border border-slate-200 px-4 py-3">
                                        <p class="font-semibold text-slate-800">
                                            {docente.grado && `${docente.grado} `}
                                            {docente.nombre}
                                        </p>
                                        {docente.rol && <p class="text-sm text-slate-500">{docente.rol}</p>}
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }
            </div>

            <aside class="lg:col-span-1">
                <div class="space-y-6 lg:sticky lg:top-8">
                    <div class="overflow-hidden rounded-xl border border-slate-200 shadow-sm">
                        <h2 class="bg-unmsm-azul px-5 py-3 font-serif font-bold text-white">
                            Información clave
                        </h2>
                        <dl class="divide-y divide-slate-100 px-5">
                            {
                                datosClave.map((dato) => (
                                    <div class="py-3">
                                        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">
                                            {dato.etiqueta}
                                        </dt>
                                        <dd class="mt-0.5 font-semibold text-slate-800">{dato.valor}</dd>
                                    </div>
                                ))
                            }
                        </dl>

                        <div class="space-y-3 p-5 pt-4">
                            <Boton href="/admision" variante="azul" icono={faUserPlus} ancho>Cómo inscribirte</Boton>
                            {
                                contacto.whatsapp && (
                                    <Boton
                                        href={contacto.whatsapp}
                                        variante="contorno"
                                        icono={faWhatsapp}
                                        ancho
                                        nuevaPestana
                                    >
                                        Consultar por WhatsApp
                                    </Boton>
                                )
                            }
                        </div>
                    </div>

                    <div class="rounded-xl bg-unmsm-azul-dark p-5 text-sm text-slate-300">
                        <h2 class="font-serif font-bold text-white">¿Necesitas ayuda?</h2>
                        <p class="mt-2">Contáctanos directamente:</p>
                        <ul class="mt-3 space-y-2">
                            {
                                contacto.email && (
                                    <li>
                                        <a
                                            href={`mailto:${contacto.email}`}
                                            class="break-all hover:text-white"
                                        >
                                            {contacto.email}
                                        </a>
                                    </li>
                                )
                            }
                            {contacto.telefono && <li>{contacto.telefono}</li>}
                        </ul>
                    </div>
                </div>
            </aside>
        </div>

        {
            relacionados.length > 0 && (
                <section class="border-t border-slate-200 bg-slate-50 py-16">
                    <div class="mx-auto max-w-6xl px-6">
                        {/* Blade deja la ficha sin salida: o vuelves atrás o te vas.
                            Aquí se ofrece a dónde seguir. */}
                        <h2 class="font-serif text-2xl font-bold text-unmsm-azul">
                            Otros {tipo.plural.toLowerCase()}
                        </h2>
                        <div class="mt-2 h-1 w-16 rounded-full bg-unmsm-dorado" aria-hidden="true" />

                        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                            {relacionados.map((otro) => (
                                <TarjetaPrograma programa={otro} />
                            ))}
                        </div>
                    </div>
                </section>
            )
        }
    </article>
</Base>
