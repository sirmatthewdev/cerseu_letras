---
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import { obtenerPaginaOpcional, obtenerConfiguracion, obtenerDirectorio } from '../lib/api';

const pagina = await obtenerPaginaOpcional('nosotros');
const sitio = await obtenerConfiguracion();

// Las autoridades son la unidad «AUTORIDADES» del directorio, como en el sitio
// anterior: se cargan en un solo sitio del panel y salen en los dos. Hoy el
// directorio esta vacio y la seccion no se pinta.
const directorio = await obtenerDirectorio();
const autoridades =
    directorio.find((u) => u.unidad.toUpperCase() === 'AUTORIDADES')?.personas ?? [];

// El agrupado lo decide el panel, no esta plantilla: cada sección trae su
// `grupo`, y aquí solo se reparten. Si la Unidad añade un valor más desde
// el panel, en «Páginas de contenido», aparece sin tocar código.
const de = (grupo: string) => pagina.secciones.filter((s) => s.grupo === grupo);

const mision = de('mision')[0];
const vision = de('vision')[0];
const valores = de('valor');
---

<Base
    titulo={pagina.titulo ?? 'Nosotros'}
    descripcion="Misión, visión y valores del CERSEU de la Facultad de Letras y Ciencias Humanas de la UNMSM."
    imagen={sitio.portada.imagenes[1]}
>
    <HeroPagina
        titulo={pagina.titulo ?? 'Nosotros'}
        bajada={pagina.subtitulo}
        kicker="Quiénes somos"
        imagen={sitio.portada.imagenes[1]}
        migas={[{ texto: 'Inicio', url: '/' }, { texto: 'Nosotros' }]}
    />

    <div class="mx-auto max-w-6xl px-6 py-16 pb-24">
        <div class="grid gap-8 lg:grid-cols-2">
            {
                [mision, vision].filter(Boolean).map((seccion, i) => (
                    <section
                        aria-labelledby={`bloque-${i}`}
                        class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-sm"
                    >
                        <span
                            aria-hidden="true"
                            class="absolute inset-y-0 left-0 w-1 bg-unmsm-dorado"
                        />
                        <h2
                            id={`bloque-${i}`}
                            class="font-serif text-2xl font-bold text-unmsm-azul"
                        >
                            {seccion!.titulo}
                        </h2>
                        <div
                            class="prose prose-slate mt-4 max-w-none prose-p:leading-relaxed"
                            set:html={seccion!.cuerpo}
                        />
                    </section>
                ))
            }
        </div>

        {
            valores.length > 0 && (
                <section aria-labelledby="valores" class="mt-16">
                    <TituloSeccion titulo="Valores" kicker="Lo que nos orienta" centrado />

                    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {valores.map((valor, i) => (
                            <li class="group flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-unmsm-azul/30 hover:shadow-md">
                                <span
                                    aria-hidden="true"
                                    class="flex h-9 w-9 flex-none items-center justify-center rounded-lg bg-unmsm-azul/10 font-serif text-sm font-bold text-unmsm-azul transition group-hover:bg-unmsm-azul group-hover:text-white"
                                >
                                    {String(i + 1).padStart(2, '0')}
                                </span>
                                <p class="leading-snug font-medium text-slate-700">{valor.titulo}</p>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            autoridades.length > 0 && (
                <section aria-labelledby="autoridades" class="mt-16">
                    <TituloSeccion
                        id="autoridades"
                        titulo="Autoridades"
                        kicker="Equipo directivo del CERSEU"
                        centrado
                    />

                    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        {autoridades.map((persona) => (
                            <li class="rounded-xl border border-slate-200 bg-white p-6 text-center shadow-sm">
                                {persona.cargo && (
                                    <p class="text-xs font-semibold uppercase tracking-wider text-unmsm-dorado">
                                        {persona.cargo}
                                    </p>
                                )}
                                <p class="mt-2 font-serif text-lg font-bold text-unmsm-azul">
                                    {persona.nombre}
                                </p>
                                {persona.correo && (
                                    <a
                                        href={`mailto:${persona.correo}`}
                                        class="mt-2 block break-all text-sm text-slate-600 hover:text-unmsm-azul hover:underline"
                                    >
                                        {persona.correo}
                                    </a>
                                )}
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }
    </div>
</Base>
