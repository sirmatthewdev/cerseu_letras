---
import Base from '../layouts/Base.astro';
import {
    obtenerTipos,
    obtenerConfiguracion,
    obtenerDocentes,
    obtenerProgramas,
    obtenerAnuncios,
    obtenerEventos,
    obtenerInformativos,
    obtenerTestimonios,
    obtenerDocente,
} from '../lib/api';
import AnunciosPopup from '../components/AnunciosPopup.astro';
import SeccionesPortada from '../components/SeccionesPortada.astro';
import Coordinadores from '../components/Coordinadores.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import BandaIndicadores from '../components/BandaIndicadores.astro';
import PasosInscripcion from '../components/PasosInscripcion.astro';
import OfertaDestacada from '../components/OfertaDestacada.astro';
import Boton from '../components/Boton.astro';
import FondoSeccion from '../components/FondoSeccion.astro';

import { iconoDeAccion } from '../lib/iconos';

// Se resuelve en el build: el HTML sale ya con estos datos dentro y el
// visitante no espera a ninguna petición.
const tipos = await obtenerTipos();

// El hero se edita en Configuración, no aquí. Tener el titular en la
// plantilla obligaría a desplegar para cambiar una palabra.
const sitio = await obtenerConfiguracion();
const { portada, inscripcion } = sitio;
const docentes = await obtenerDocentes();

// Los seis primeros con su detalle: la sección de coordinadores anuncia lo que
// dicta cada uno, y el listado no lo trae. Se resuelve en el build, así que no
// cuesta ninguna petición al visitante.
const coordinadores = await Promise.all(
    docentes.slice(0, 6).map((d) => obtenerDocente(d.slug))
);
const programas = await obtenerProgramas();
const fondo = portada.imagenes[0];

// Solo en la portada, como en el sitio anterior: asi no puede colarse en el
// resto de las paginas.
const anuncios = await obtenerAnuncios();

// Las tres secciones de mas abajo. Cada una se oculta si no tiene nada que
// ensenar, igual que en el sitio anterior: hoy las tres tablas estan vacias.
const [eventos, informativos, testimonios] = await Promise.all([
    obtenerEventos(),
    obtenerInformativos(),
    obtenerTestimonios(),
]);
---

<Base
    titulo="Inicio"
    descripcion="Formación abierta a toda la comunidad: talleres, cursos y especializaciones del CERSEU de la Facultad de Letras."
    sobreHero
>
    {/* Portada editorial: el contenido a la izquierda, la fotografía de la
        Facultad emergiendo por la derecha del mismo oscuro con el que sigue la
        banda de cifras.

        No es una fotografía de fondo con un velo azul encima, que es lo que
        había: la foto ocupa su propio lado y se disuelve hacia el texto con un
        degradado del color del fondo. El resultado es que la Facultad se
        reconoce —se ve el edificio, no una mancha azul— y el texto no depende
        de que la zona que le toque detrás sea oscura.

        El `pt` reserva la altura de la cabecera superpuesta. El alto no se fija
        en `100vh` a propósito: manda el contenido, y la banda de cifras tiene
        que asomar en una pantalla de escritorio sin rodar la rueda. */}
    <section class="hero-portada relative isolate overflow-hidden text-white">
        {/* Textura de puntos, la misma de la banda de cifras y de «Cómo
            inscribirte»: es lo que hace que las tres se lean como una pieza. */}
        <div
            aria-hidden="true"
            class="absolute inset-0 -z-20 opacity-[0.05]"
            style="background-image: radial-gradient(circle at 1px 1px, #fff 1.5px, transparent 0); background-size: 30px 30px;"
        >
        </div>

        {/* Luz de arriba, en dorado rebajado y muy abierta. No es un adorno
            suelto: levanta la esquina por donde entra la fotografía y evita que
            el oscuro se lea como un rectángulo plano. */}
        <div
            aria-hidden="true"
            class="hero-luz absolute -z-20"
        >
        </div>

        {/* `z-10`: la fotografia va despues en el marcado, asi que sin esto
            pintaria encima del titular. El solape es de unos pocos pixeles y cae
            sobre la parte del degradado que ya es del color del fondo —o sea que
            no se notaria—, pero basta un titular una palabra mas largo para que
            se coma una letra. */}
        {/* El marco de la portada: texto y fotografía. Se separa de la banda
            de cifras para que la fotografía, que va absoluta en escritorio, se
            posicione contra ESTE bloque y no contra la seccion entera: asi
            termina justo donde empieza la banda y su degradado inferior sirve
            de algo, en vez de quedar tapado por ella. */}
        <div class="hero-marco relative">
        <div class="relative z-10 mx-auto w-full max-w-7xl px-4 lg:px-8">
            <div class="hero-texto max-w-xl pb-12 pt-32 lg:max-w-[31rem] lg:pb-0 lg:pt-0 xl:max-w-[36rem]">
                {portada.kicker && (
                    <p class="hero-entra hero-entra-1 text-[0.7rem] font-semibold uppercase leading-relaxed tracking-[0.22em] text-unmsm-dorado-light sm:text-xs">
                        {portada.kicker}
                    </p>
                )}

                {/* Filo de marca bajo el antetítulo: el mismo gesto que separa
                    las secciones en el pie. */}
                <div
                    aria-hidden="true"
                    class="hero-entra hero-entra-1 marca-regla mt-4 h-px w-16 opacity-80"
                >
                </div>

                {portada.titulo && (
                    <h1 class="hero-entra hero-entra-2 mt-7 font-serif text-[2.1rem] font-bold leading-[1.05] sm:text-5xl lg:text-[3.4rem] xl:text-[3.8rem]">
                        {portada.titulo}
                    </h1>
                )}

                {portada.claim && (
                    <p class="hero-entra hero-entra-3 mt-6 font-serif text-lg leading-snug text-unmsm-dorado-light sm:text-xl lg:text-2xl">
                        {portada.claim}
                    </p>
                )}

                {portada.texto && (
                    <p class="hero-entra hero-entra-4 mt-6 max-w-lg leading-relaxed text-slate-300 lg:text-lg">
                        {portada.texto}
                    </p>
                )}

                {portada.acciones.length > 0 && (
                    <div class="hero-entra hero-entra-5 mt-10 flex flex-wrap gap-3">
                        {portada.acciones.map((accion, i) => (
                            /* A ancho completo mientras quepan uno por linea: el
                               ancho lo daba el texto, asi que apilados en movil
                               salian dos botones de largos distintos, escalonados.
                               Desde `sm` vuelven a medir lo que miden. */
                            <Boton
                                href={accion.url}
                                variante={i === 0 ? 'dorado' : 'contorno-claro'}
                                tamano="grande"
                                /* Las dos acciones las escribe la Unidad desde el
                                   panel, destino incluido, asi que el icono lo da
                                   la URL en las dos. Hoy son «Ver cursos» y «Cómo
                                   inscribirse», o sea el birrete y la persona con
                                   el mas. */
                                icono={iconoDeAccion(accion.url)}
                                clase="max-sm:w-full"
                            >
                                {accion.texto}
                            </Boton>
                        ))}
                    </div>
                )}
            </div>
        </div>
        </div>

        {/* Las cifras, dentro del hero y no debajo. Cierran la pantalla de
            entrada: quien llega ve el nombre, lo que se ofrece, por donde se
            entra y cuanto hay, sin rodar la rueda. Lo que hay despues empieza
            al desplazarse. */}
        <BandaIndicadores tipos={tipos} docentes={portada.docentes ?? docentes.length} />

        {/* La fotografía, a sangre en la sección entera.
            
            Cuelga de la sección y no del marco de texto: así llega también a la
            franja que ocupa la cabecera —que va transparente sobre el hero— y a
            la banda de cifras de abajo. La pantalla de entrada es una sola
            imagen de principio a fin, no una imagen con dos bordes pegados.

            Va DESPUÉS del texto en el marcado y no antes: la posiciona el CSS,
            y dejarla al final mantiene el orden de lectura del documento
            —titular, texto, botones— para quien navega con teclado o lector.

            Tres capas, cada una con un trabajo:

              · `hero-foto-raton`  la desplaza unos pixeles siguiendo al raton;
              · `hero-foto-img`    lleva la deriva constante, lenta;
              · `hero-foto-fundido` protege el contraste del texto.

            Separadas porque las dos primeras animan `transform` y una sola no
            puede llevar las dos: la del raton pisaria la deriva en cada
            movimiento. */}
        {fondo && (
            <div class="hero-foto">
                <div class="hero-foto-raton">
                    <img
                        src={fondo}
                        alt="Fachada de la Facultad de Letras y Ciencias Humanas de la UNMSM"
                        fetchpriority="high"
                        decoding="async"
                        class="hero-foto-img"
                    />
                </div>

                {/* El contraste del texto no se deja al azar de la fotografia.
                    Es un degradado del color del fondo, no un velo plano de otro
                    color: sobre la columna de texto llega al 92 % y se abre
                    hacia la derecha hasta desaparecer, de modo que el edificio
                    se ve entero donde no hay nada escrito. Un velo uniforme
                    daria el contraste igual, pero apagaria la Facultad, que es
                    lo que se venia a arreglar. */}
                <span aria-hidden="true" class="hero-foto-fundido"></span>
            </div>
        )}
    </section>


    {/* El orden es el que tenia la portada anterior: primero como se entra,
        despues quienes somos, y solo entonces la oferta. Se recupera porque
        era una decision, no un accidente: quien llega buscando inscribirse no
        tiene que recorrer el catalogo entero para encontrar el camino. */}
    {inscripcion && <PasosInscripcion inscripcion={inscripcion} />}

    {/* Banda de marca. El azul plano de antes no era lo que tenía el sitio
        anterior: iba en degradado de azul a dorado, y sin él la sección se lee
        como un bloque de color puesto ahí. El degradado se desplaza al pasar
        —`data-banda-degradado`—, así que el dorado recorre la banda en vez de
        quedarse clavado en una esquina. */}
    <section
        data-banda-degradado
        class="banda-marca relative isolate overflow-hidden py-16 text-white"
    >
        <FondoSeccion tono="oscuro" deriva={80} />

        <div class="relative mx-auto flex max-w-6xl flex-col gap-6 px-6 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-unmsm-dorado-light">
                    {portada.kicker}
                </p>
                <h2 class="mt-2 font-serif text-2xl font-bold sm:text-3xl">
                    Tradición humanística, vocación de futuro
                </h2>
                <p class="mt-3 max-w-2xl text-slate-200">
                    En la universidad más antigua de América, el CERSEU acerca las letras y
                    las ciencias humanas a toda la comunidad.
                </p>
            </div>
            <Boton href="/nosotros" variante="contorno-claro" icono={iconoDeAccion('/nosotros')}>
                Conócenos
            </Boton>
        </div>
    </section>

    {/* `id` para que el botón «Ver cursos» del hero baje hasta aquí en vez de
        salir a /cursos: la portada ya enseña la oferta, y mandar fuera a quien
        acaba de llegar es hacerle salir de la pagina para ver lo que tiene dos
        pantallas mas abajo.

        `scroll-mt-24` porque la cabecera es fija: sin margen de desplazamiento,
        el ancla deja el titulo de la seccion justo debajo de la capsula. Es el
        mismo recurso que usan las anclas de /tramites. */}
    <section id="oferta" class="relative isolate scroll-mt-24 overflow-hidden bg-slate-50 py-20">
        <FondoSeccion />

      <div class="relative mx-auto max-w-6xl px-6">
        <TituloSeccion
            titulo="Nuestra oferta"
            kicker="Formación abierta"
            bajada="Cada tipo se mide con la unidad que le es propia."
            centrado
        />

        <div class="mt-12">
            <OfertaDestacada tipos={tipos} programas={programas} />
        </div>
      </div>
    </section>

    <Coordinadores docentes={coordinadores} />

    <SeccionesPortada eventos={eventos} informativos={informativos} testimonios={testimonios} />

    <AnunciosPopup anuncios={anuncios} />
</Base>

<style>
    .banda-marca {
        background-image: var(--degradado-banda);
        background-size: 200% 100%;
        background-position: 0% 50%;
    }

    /*
     * HERO DE LA PORTADA
     *
     * Fondo plano y no degradado: debajo empieza la banda de cifras con este
     * mismo color, de modo que las dos se leen como una sola pieza y no hay
     * costura que disimular. La profundidad la ponen la textura de puntos y la
     * luz de arriba, no un degradado vertical.
     *
     * El plano tambien es lo que permite que la fotografia se funda con un
     * degradado de ESTE color: con un fondo degradado habria que perseguirlo a
     * cada altura y la costura se veria.
     */
    .hero-portada {
        background-color: var(--color-fondo-hondo);
    }

    .hero-luz {
        top: -18rem;
        right: -12rem;
        height: 40rem;
        width: 40rem;
        border-radius: 9999px;
        background: radial-gradient(
            circle,
            color-mix(in oklab, var(--color-unmsm-dorado) 22%, transparent) 0%,
            transparent 68%
        );
        filter: blur(36px);
        pointer-events: none;
    }

    /*
     * La fotografia ocupa la seccion entera, detras de todo lo demas.
     *
     * `z-index: -1` y no `0`: la seccion aisla con `isolate`, asi que el valor
     * negativo la deja por detras del texto Y de la banda de cifras sin salirse
     * de la seccion, y por delante del color de fondo y de la textura de puntos.
     * Con `0` habria tapado la banda, que va despues en el marcado.
     */
    .hero-foto {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    /*
     * La capa que sigue al raton. El script solo escribe dos variables; el
     * `transform` lo compone el CSS. Asi el movimiento del raton y la deriva
     * constante no se pisan: son dos elementos distintos.
     */
    .hero-foto-raton {
        position: absolute;
        /* Sobra por los cuatro lados: el desplazamiento del raton y el zoom de
           la deriva no pueden llegar a descubrir el borde. */
        inset: -5%;
        transform: translate3d(var(--raton-x, 0px), var(--raton-y, 0px), 0);
        will-change: transform;
    }

    .hero-foto-img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        /* Tratamiento navy, sin pasarse: la foto tiene que seguir
           reconociendose. Un punto menos de saturacion y algo de contraste
           bastan para que no compita con el texto. */
        filter: saturate(0.82) contrast(1.06) brightness(0.92);
    }

    /*
     * El fundido. Dos degradados del color del fondo sobre la propia foto:
     * arriba para que emerja del oscuro, abajo para que entregue a la banda de
     * cifras. No es una mascara —`mask-composite` para cruzar dos direcciones
     * es justo el tipo de cosa que se rompe en un navegador y nadie se entera—:
     * son dos capas de `background` en un solo elemento.
     */
    .hero-foto-fundido {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
            /* Sombra bajo la cabecera, que va transparente sobre el hero. */
            linear-gradient(
                to bottom,
                color-mix(in oklab, var(--color-fondo-hondo) 88%, transparent) 0%,
                transparent 26%
            ),
            /* En vertical: el texto ocupa la parte de arriba, asi que ahi el
               fondo es casi opaco y se abre hacia abajo, donde no hay nada
               escrito y la Facultad se ve. */
            linear-gradient(
                to bottom,
                color-mix(in oklab, var(--color-fondo-hondo) 94%, transparent) 0%,
                /* Casi opaco hasta donde acaban los botones; de ahi se abre y
                   la Facultad se ve. El tramo final ya no tiene que hacer de
                   fondo de las cifras —eso lo pone la banda— y por eso puede
                   quedarse a medias en vez de cerrarse. */
                color-mix(in oklab, var(--color-fondo-hondo) 88%, transparent) 38%,
                /* A partir de aqui se abre y no se vuelve a cerrar: lo que queda
                   por debajo es la banda de cifras, que ya pone su propio fondo
                   al 82 %. Cerrando tambien aqui, las dos capas se sumaban y la
                   Facultad no se veia en ningun tramo. */
                color-mix(in oklab, var(--color-fondo-hondo) 26%, transparent) 56%,
                color-mix(in oklab, var(--color-fondo-hondo) 26%, transparent) 100%
            );
    }

    @media (min-width: 1024px) {
        /*
         * El hero ocupa la pantalla entera y la banda de cifras queda debajo
         * del pliegue: se llega a ella rodando la rueda, no de entrada.
         *
         * `100svh` y no `100vh`: en un movil con la barra de direcciones a la
         * vista, `100vh` cuenta el alto SIN esa barra, de modo que el hero
         * sobresale por abajo y la pagina arranca con un desplazamiento que
         * nadie ha pedido. `svh` es el alto estable, el pequeño, y no da ese
         * salto. Solo se aplica desde 1024 de todos modos, donde en movil el
         * contenido y la foto ya pasan del alto de la pantalla.
         *
         * El relleno superior reserva la cabecera fija: el centrado reparte lo
         * que queda, no la pantalla entera, o el contenido caeria bajo la
         * capsula en una pantalla corta.
         */
        .hero-portada {
            display: flex;
            /* En columna: arriba el marco —texto y fotografia— y abajo la banda
               de cifras, pegada al borde inferior de la pantalla. */
            flex-direction: column;
            min-height: 100svh;
            padding-top: var(--alto-cabecera);
        }

        /* Se queda con todo el alto que la banda no usa, y centra el contenido
           dentro de el. */
        .hero-marco {
            flex: 1;
            display: flex;
            align-items: center;
        }


        /* En horizontal el texto esta a la izquierda: el fondo es casi opaco
           en esa columna y se abre hacia la derecha, donde esta el edificio.
           Un velo plano de lado a lado daria el mismo contraste y apagaria la
           Facultad; esto la deja verse donde no estorba. */
        .hero-foto-fundido {
            background:
                /* La cabecera va transparente sobre el hero y ahora la
                   fotografia llega hasta arriba del todo: sin este tramo,
                   «Trámites», «Actualidad» y la lupa caen sobre el cielo. El
                   segundo punto esta a la altura a la que termina la capsula. */
                linear-gradient(
                    to bottom,
                    color-mix(in oklab, var(--color-fondo-hondo) 90%, transparent) 0%,
                    color-mix(in oklab, var(--color-fondo-hondo) 72%, transparent) 14%,
                    transparent 34%
                ),
                /* El tramo casi opaco llega al 42 %, que es donde termina la
                   columna de texto a 1440 —el titular cerraba justo en el 30 %,
                   sobre el borde del degradado, sin margen ninguno—. De ahi en
                   adelante se abre y el edificio se ve. */
                linear-gradient(
                    to right,
                    var(--color-fondo-hondo) 0%,
                    color-mix(in oklab, var(--color-fondo-hondo) 92%, transparent) 42%,
                    color-mix(in oklab, var(--color-fondo-hondo) 45%, transparent) 64%,
                    transparent 86%
                ),
                /* Un desvanecido corto al llegar a la banda de cifras, nada
                   mas: el fondo de las cifras lo pone la propia banda, que es
                   quien sabe donde empieza. Opaco aqui volveria a cortar la
                   fotografia. */
                linear-gradient(to top, color-mix(in oklab, var(--color-fondo-hondo) 55%, transparent) 0%, transparent 16%);
        }

    }

    /*
     * Entrada: lo mismo que hace el resto del sitio al desvelar una seccion
     * —opacidad y un empujon de 18 px—, escalonado.
     *
     * El estado oculto vive DENTRO de la media query, nunca fuera: si el
     * navegador no anima, el hero se ve y ya esta. Al reves es como se llega a
     * una portada en blanco.
     */
    @media (prefers-reduced-motion: no-preference) {
        .hero-entra {
            animation: hero-entra 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) both;
        }

        .hero-entra-1 {
            animation-delay: 0.05s;
        }
        .hero-entra-2 {
            animation-delay: 0.14s;
        }
        .hero-entra-3 {
            animation-delay: 0.23s;
        }
        .hero-entra-4 {
            animation-delay: 0.3s;
        }
        .hero-entra-5 {
            animation-delay: 0.38s;
        }

        /* La fotografia entra sola y mas despacio, sin desplazarse: moverla
           ademas de los textos serian dos cosas viajando a la vez. */
        .hero-foto {
            animation: hero-foto-entra 1.1s ease-out both;
            animation-delay: 0.1s;
        }

        /*
         * Deriva constante. Muy lenta y muy corta: 34 segundos de ida y vuelta
         * sobre un 5 % de escala. Lo que se busca es que la imagen no parezca
         * congelada, no que se note que se mueve; a la velocidad a la que se
         * lee un titular, el desplazamiento es imperceptible y aun asi la
         * portada deja de estar quieta.
         *
         * `alternate` y no un bucle que salte: una vuelta al punto de partida
         * daria un tiron cada 34 segundos.
         */
        .hero-foto-img {
            animation: hero-deriva 34s ease-in-out infinite alternate;
        }
    }

    @keyframes hero-deriva {
        from {
            transform: scale(1.04) translate3d(0, 0, 0);
        }
        to {
            transform: scale(1.09) translate3d(-1.6%, -1.2%, 0);
        }
    }

    /*
     * Los fotogramas se declaran AQUI y no se toma prestado el `aparecer` de
     * `global.css`: Astro renombra los nombres de animacion que encuentra en un
     * `<style>` de componente, y el renombrado apuntaba a unos fotogramas que
     * no existen. La animacion no fallaba con un error, simplemente no ocurria.
     */
    @keyframes hero-entra {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    /*
     * La fotografia no arranca en invisible.
     *
     * Es la unica pieza del hero que, si la animacion no llega a correr, deja
     * la mitad de la portada en negro —y no correr es un caso real: en una
     * pestaña que aun no esta en primer plano el reloj de animaciones no
     * avanza—. Entra desde una opacidad alta y un pelo de escala, de modo que
     * el estado de partida ya es un estado presentable. Es la misma regla que
     * `global.css` se escribio para el desvelado: nunca esconder primero y
     * confiar en que algo lo revele.
     */
    @keyframes hero-foto-entra {
        from {
            opacity: 0.55;
            transform: scale(1.035);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

<script>
    /*
     * La fotografía del hero sigue al ratón, unos pocos píxeles.
     *
     * Sin librería y sin tocar el diseño: el script solo escribe dos variables
     * CSS y el `transform` lo compone la hoja de estilos. Así la deriva
     * constante —que vive en otra capa— y este desplazamiento no se pisan.
     *
     * Tres condiciones para que exista siquiera:
     *
     *   · `pointer: fine`, o sea que haya un ratón de verdad. En una pantalla
     *     táctil no hay nada que seguir y el oyente solo gastaría batería.
     *   · movimiento no reducido, como el resto de las animaciones del sitio.
     *   · que el hero esté en la página. Esto es la portada, pero el layout es
     *     compartido y un `querySelector` nulo no puede tumbar nada.
     *
     * El seguimiento va con interpolación —cada cuadro recorre un 6 % de lo que
     * falta— para que la imagen acompañe al puntero en vez de pegarse a él: un
     * seguimiento exacto se lee como un defecto, no como profundidad. Y el
     * bucle se detiene solo cuando ya no queda distancia que recorrer, de modo
     * que no hay un `requestAnimationFrame` corriendo de fondo para siempre.
     */
    function seguirAlRaton() {
        const marco = document.querySelector<HTMLElement>('.hero-marco');
        const capa = document.querySelector<HTMLElement>('.hero-foto-raton');

        if (!marco || !capa) return;
        if (capa.dataset.siguiendo === '1') return;

        if (
            !window.matchMedia('(pointer: fine)').matches ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
            return;
        }

        capa.dataset.siguiendo = '1';

        /** Cuánto se desplaza como máximo, en píxeles. */
        const ALCANCE_X = 16;
        const ALCANCE_Y = 11;

        let destinoX = 0;
        let destinoY = 0;
        let actualX = 0;
        let actualY = 0;
        let enMarcha = false;

        function acercarse() {
            actualX += (destinoX - actualX) * 0.06;
            actualY += (destinoY - actualY) * 0.06;

            capa!.style.setProperty('--raton-x', `${(actualX * ALCANCE_X).toFixed(2)}px`);
            capa!.style.setProperty('--raton-y', `${(actualY * ALCANCE_Y).toFixed(2)}px`);

            if (Math.abs(destinoX - actualX) > 0.002 || Math.abs(destinoY - actualY) > 0.002) {
                requestAnimationFrame(acercarse);
            } else {
                enMarcha = false;
            }
        }

        function apuntar(x: number, y: number) {
            const caja = marco!.getBoundingClientRect();
            // De -1 a 1, con el centro del marco en el cero.
            destinoX = ((x - caja.left) / caja.width - 0.5) * 2;
            destinoY = ((y - caja.top) / caja.height - 0.5) * 2;

            if (!enMarcha) {
                enMarcha = true;
                requestAnimationFrame(acercarse);
            }
        }

        // En la ventana y no en el marco: la cabecera y los botones se montan
        // encima, y escuchando solo al marco la imagen se quedaba clavada cada
        // vez que el puntero pasaba sobre ellos.
        window.addEventListener(
            'pointermove',
            (evento) => {
                if (evento.pointerType !== 'mouse') return;
                apuntar(evento.clientX, evento.clientY);
            },
            { passive: true }
        );

        // Al salir de la ventana vuelve al centro, que si no se queda torcida.
        document.addEventListener('pointerleave', () => {
            destinoX = 0;
            destinoY = 0;

            if (!enMarcha) {
                enMarcha = true;
                requestAnimationFrame(acercarse);
            }
        });
    }

    seguirAlRaton();
    document.addEventListener('astro:page-load', seguirAlRaton);
</script>
